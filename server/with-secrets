#!/usr/bin/python3 -I
"""with-secrets: run one command with shared keys in its environment, and nowhere else.

Usage:
  with-secrets NAME [NAME...] -- command [args...]
  with-secrets --check NAME [NAME...]       print only the key names in each file, never the values

Each NAME is a runtime bundle synced by swarm-sync-secrets. On older, unmigrated workers only, NAME
is a legacy .env file in ~/.config/agent-secrets (or $SWARM_SECRETS_DIR). Values are never printed.

Honest limit: any task that can run with-secrets can read these keys. Only add keys that are fine for every
task to use. Prefer restricted keys with spending caps. See docs/secrets.md.
"""
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")
KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def fail(msg, code=2):
    print(f"with-secrets: {msg}", file=sys.stderr)
    sys.exit(code)


def secrets_dir():
    return os.path.expanduser(os.environ.get("SWARM_SECRETS_DIR") or "~/.config/agent-secrets")


def bundle_name(name):
    return bool(NAME_RE.fullmatch(name) and ".." not in name)


def config_dir():
    return Path.home() / ".config" / "swarm-secrets"


def configured(base):
    return any(os.path.lexists(base / name) for name in ("runtime-bundles", "cache.json"))


def open_private(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    except FileNotFoundError:
        fail(f"no secret file at {path}; ask the owner to set up or sync the bundles")
    except OSError as e:
        if os.path.islink(path):
            fail(f"{path} is a symbolic link; refusing")
        fail(f"cannot open {path}: {e.strerror}")
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        os.close(fd)
        fail(f"{path} must be a regular file owned by this user with mode 600 or stricter (chmod 600)")
    return os.fdopen(fd, encoding="utf-8")


def valid_values(values):
    return isinstance(values, dict) and all(KEY_RE.fullmatch(key) and isinstance(value, str) and "\0" not in value
                                            for key, value in values.items())


def load(name, cache):
    if not bundle_name(name):
        fail("bad secret name: use letters, digits, dot, dash and underscore")
    if cache is not None:
        if name not in cache:
            fail(f"no runtime bundle named {name}; ask the owner to add and sync it")
        return cache[name]
    path = os.path.join(secrets_dir(), name + ".env")
    with open_private(path) as fh:
        values = {}
        for n, line in enumerate(fh, 1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("export "):
                line = line[7:].lstrip()
            if "=" not in line:
                fail(f"{path} line {n}: expected KEY=VALUE")
            k, v = line.split("=", 1)
            k, v = k.strip(), v.strip()
            if not KEY_RE.match(k):
                fail(f"{path} line {n}: bad key name")
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                v = v[1:-1]
            values[k] = v
    if not values:
        fail(f"{path} has no KEY=VALUE lines")
    return values


def read_cache():
    base = config_dir()
    if not configured(base):
        return None
    with open_private(base / "cache.json") as stream:
        try:
            cache = json.load(stream)
        except (ValueError, UnicodeError):
            fail("invalid secret cache; run swarm-sync-secrets")
    if not isinstance(cache, dict) or not all(valid_values(values) for values in cache.values()):
        fail("invalid secret cache; run swarm-sync-secrets")
    return cache


def sync(argv):
    if argv not in ([], ["--if-configured"]):
        fail("usage: swarm-sync-secrets [--if-configured]")
    base = config_dir()
    if not configured(base) and argv:
        return 0
    os.umask(0o077)
    manifest = base / "runtime-bundles"
    if not os.path.lexists(manifest):
        fail("missing runtime-bundles; see the encrypted secrets setup guide")
    key = base / "age.key"
    open_private(key).close()
    repo = base / "repo"
    if not (repo / ".git").is_dir():
        fail("missing secrets checkout")
    env = {name: value for name, value in os.environ.items() if not name.startswith("SOPS_")}
    env.update(SOPS_AGE_KEY_FILE=str(key), GIT_TERMINAL_PROMPT="0")

    def run(command, message, data=None):
        try:
            return subprocess.run(command, input=data, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                  env=env, check=True, timeout=90).stdout
        except (OSError, subprocess.SubprocessError):
            fail(message + "; previous cache unchanged")

    with (base / "sync.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with open_private(manifest) as stream:
            names = stream.read().split()
        if not all(bundle_name(name) for name in names):
            fail("invalid name in runtime-bundles")
        git = ["git", "-C", str(repo)]
        run(git + ["pull", "--ff-only", "--quiet"], "could not pull encrypted bundles")
        revision = run(git + ["rev-parse", "HEAD"], "could not read the secrets revision").decode().strip()
        cache = {}
        for name in dict.fromkeys(names):
            encrypted = run(git + ["show", f"{revision}:runtime/{name}.json"], f"missing runtime bundle {name}")
            decoded = run(["sops", "decrypt", "--input-type", "json", "--output-type", "json", "/dev/stdin"],
                          f"could not decrypt runtime bundle {name}", encrypted)
            try:
                values = json.loads(decoded)
            except (ValueError, UnicodeError):
                fail(f"runtime bundle {name} is not valid JSON; previous cache unchanged")
            if not valid_values(values):
                fail(f"runtime bundle {name} must map environment names to strings; previous cache unchanged")
            cache[name] = values
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", dir=base, prefix="cache-", encoding="utf-8", delete=False) as stream:
                temporary = stream.name
                json.dump(cache, stream)
            os.replace(temporary, base / "cache.json")
        finally:
            if temporary:
                Path(temporary).unlink(missing_ok=True)
    print(f"swarm-sync-secrets: synced {len(cache)} runtime bundle(s)")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "--check":
        cache = read_cache()
        for name in argv[1:]:
            print(f"{name}: " + ", ".join(sorted(load(name, cache))))
        return 0
    if "--" not in argv:
        fail("usage: with-secrets NAME [NAME...] -- command [args...]")
    i = argv.index("--")
    names, cmd = argv[:i], argv[i + 1:]
    if not names:
        fail("name at least one secret file before --")
    if not cmd:
        fail("give a command after --")
    env = dict(os.environ)
    cache = read_cache()
    for name in names:
        env.update(load(name, cache))
    try:
        os.execvpe(cmd[0], cmd, env)
    except FileNotFoundError:
        fail(f"command not found: {cmd[0]}", 127)
    except PermissionError:
        fail(f"cannot run {cmd[0]}", 126)


if __name__ == "__main__":
    sys.exit(sync(sys.argv[1:]) if Path(sys.argv[0]).name == "swarm-sync-secrets" else main(sys.argv[1:]))
