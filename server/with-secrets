#!/usr/bin/python3 -I
"""with-secrets: run one command with shared keys in its environment, and nowhere else.

Usage:
  with-secrets NAME [NAME...] -- command [args...]
  with-secrets --check NAME [NAME...]       print only the key names in each file, never the values

Each NAME is a file: $SWARM_SECRETS_DIR/NAME.env (default ~/.config/agent-secrets/NAME.env) with KEY=VALUE
lines. Blank lines and lines starting with # are skipped. Values may be wrapped in single or double quotes.
The file must be a regular file (not a link), owned by the user running this, and readable by that user
only (mode 600 or stricter). Otherwise it refuses. Values are never printed.

Honest limit: any task that can run with-secrets can read these keys. Only add keys that are fine for every
task to use. Prefer restricted keys with spending caps. See docs/secrets.md.
"""
import os
import re
import stat
import sys

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")
KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def fail(msg, code=2):
    print(f"with-secrets: {msg}", file=sys.stderr)
    sys.exit(code)


def secrets_dir():
    return os.path.expanduser(os.environ.get("SWARM_SECRETS_DIR") or "~/.config/agent-secrets")


def load(name):
    if not NAME_RE.match(name) or ".." in name:
        fail(f"bad secret name {name!r}: use letters, digits, dot, dash and underscore")
    path = os.path.join(secrets_dir(), name + ".env")
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        fail(f"no secret file for {name!r} ({path}). Ask the owner to add it; never put the value in a brief.")
    except OSError as e:
        if os.path.islink(path):
            fail(f"{path} is a symbolic link; refusing")
        fail(f"cannot open {path}: {e.strerror}")
    with os.fdopen(fd) as fh:
        st = os.fstat(fh.fileno())
        if not stat.S_ISREG(st.st_mode):
            fail(f"{path} is not a regular file; refusing")
        if st.st_uid != os.getuid():
            fail(f"{path} is not owned by this user; refusing")
        if st.st_mode & 0o077:
            fail(f"{path} can be read by other users (mode {oct(st.st_mode & 0o777)}); run: chmod 600 {path}")
        values = {}
        for n, line in enumerate(fh, 1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("export "):
                line = line[7:].lstrip()
            if "=" not in line:
                fail(f"{path} line {n}: expected KEY=VALUE")
            k, v = line.split("=", 1)
            k, v = k.strip(), v.strip()
            if not KEY_RE.match(k):
                fail(f"{path} line {n}: bad key name")
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                v = v[1:-1]
            values[k] = v
    if not values:
        fail(f"{path} has no KEY=VALUE lines")
    return values


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "--check":
        for name in argv[1:]:
            print(f"{name}: " + ", ".join(sorted(load(name))))
        return 0
    if "--" not in argv:
        fail("usage: with-secrets NAME [NAME...] -- command [args...]")
    i = argv.index("--")
    names, cmd = argv[:i], argv[i + 1:]
    if not names:
        fail("name at least one secret file before --")
    if not cmd:
        fail("give a command after --")
    env = dict(os.environ)
    for name in names:
        env.update(load(name))
    try:
        os.execvpe(cmd[0], cmd, env)
    except FileNotFoundError:
        fail(f"command not found: {cmd[0]}", 127)
    except PermissionError:
        fail(f"cannot run {cmd[0]}", 126)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
