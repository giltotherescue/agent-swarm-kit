#!/usr/bin/python3 -I
"""agent-exec: the only door from the runner (swarm-runner user) into the agent user.

The runner calls it through one sudoers rule:
    swarm-runner ALL=(agent) NOPASSWD: /usr/local/lib/agent-swarm/agent-exec
so everything here runs as the agent user, with a clean environment. The runner never runs git
or reads files inside the agent's folders itself; it exchanges files through two handoff folders:
    HANDOFF/inbox/TASK    written by the runner, read by the agent (brief, prompt, attachments, messages, bundles)
    HANDOFF/outbox/TASK   written here, read by the runner (report, status, session ids, artifacts, work bundle)

Usage (all paths are passed by the runner; sudo removes the caller's environment):
  agent-exec --work DIR --handoff DIR prepare TASK WORKNAME [--branch B] [--origin URL] [--drop-checkpoint]
  agent-exec --work DIR --handoff DIR run TASK WORKNAME --timeout SECONDS [--scope] [--require-scope]
             [--memory 75%] [--cpu 200%] [--agent-env FILE] [--task-env A=v,B=w] -- COMMAND ARGS...
  agent-exec --work DIR --handoff DIR stop TASK [--grace 20]
  agent-exec --work DIR --handoff DIR stop-all
  agent-exec --work DIR --handoff DIR collect TASK WORKNAME
  agent-exec --work DIR --handoff DIR cleanup TASK
  agent-exec --work DIR --handoff DIR exists WORKNAME
  agent-exec --work DIR --handoff DIR exec WORKNAME [--agent-env FILE] -- COMMAND ARGS...
Orchestrators (WORK/orchestrators/NAME, tmux socket and session orch-NAME; see docs/orchestrators.md):
  agent-exec --work DIR --handoff DIR orch-prepare NAME [--origin URL]
  agent-exec --work DIR --handoff DIR orch-start NAME [--agent-env FILE] [--secrets A,B] [--with-secrets PATH]
             [--relay-name X] [--scope] -- COMMAND ARGS...
  agent-exec --work DIR --handoff DIR orch-status NAME [--lines N] [--sessions-dir DIR]
  agent-exec --work DIR --handoff DIR orch-capture NAME [--pane %N]   (JSON {pane, screen}: one pane, resolved once per attempt)
  agent-exec --work DIR --handoff DIR orch-type NAME --pane %N [--id ID] [--plain]   (types inbox/orch-NAME/line.txt as literal
      keys and checks the editor holds exactly it; --id first copies inbox/orch-NAME/message.md to the session's
      .orchestrator/inbox/msg-ID.md. Exit 0 typed and verified, 5 nothing typed, 8 not landed and erased, 9 not landed, left)
  agent-exec --work DIR --handoff DIR orch-enter NAME --pane %N --before N [--plain]   (fresh capture: Enter only while the
      editor holds exactly line.txt, then confirm; JSON {state: submitted|in_editor|unknown|not_in_editor|enter_failed})
  agent-exec --work DIR --handoff DIR orch-kill NAME
  agent-exec --work DIR --handoff DIR orch-keys NAME KEY...   (only Enter, Down, Up, Escape, 1-9: answers a first-run screen)
  agent-exec --work DIR --handoff DIR orch-check NAME [--agent-env FILE] [--claude-dir DIR]   (does Claude have a sign-in?)
  agent-exec --work DIR --handoff DIR orch-relay NAME --relay-name X [--agent-env FILE] -- COMMAND ARGS...
Output is JSON on stdout for prepare and collect. No secrets are ever printed.
"""
import json
import os
import pwd
import re
import shutil
import signal
import stat
import subprocess
import sys
import time
import unicodedata

VERSION = "0.8.1"
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,80}$")
BRANCH_RE = re.compile(r"^(?!.*\.\.)(?!/)[A-Za-z0-9._/-]{1,200}$")
MAX_ARTIFACT = 25 * 1024 * 1024
MAX_ARTIFACTS = 200
NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
GIT = ["git", "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null"]


def die(msg, code=2):
    print(f"agent-exec: {msg}", file=sys.stderr)
    sys.exit(code)


def check_name(v, what):
    if not NAME_RE.fullmatch(v or "") or ".." in v:
        die(f"bad {what}: {v!r}")
    return v


MAC_DIRS = ("/opt/homebrew/opt/coreutils/libexec/gnubin", "/opt/homebrew/bin",
            "/usr/local/opt/coreutils/libexec/gnubin")


def task_path(home, platform=sys.platform, exists=os.path.isdir):
    """PATH for tasks. On Linux it is fixed. On a Mac it also has Homebrew (and GNU coreutils, for `timeout`) in front."""
    base = f"{home}/.local/bin:{home}/bin:/usr/local/bin:/usr/bin:/bin"
    if platform != "darwin":
        return base
    return ":".join([d for d in MAC_DIRS if exists(d)] + [base])


def timeout_command(path, which=shutil.which):
    """The GNU `timeout` program: `timeout`, or Homebrew's `gtimeout` on a Mac that has no gnubin on its PATH."""
    if which("timeout", path=path) or not which("gtimeout", path=path):
        return "timeout"
    return "gtimeout"


def clean_env(task=None, timeout=None, agent_env=None, task_env=None):
    pw = pwd.getpwuid(os.getuid())
    home = pw.pw_dir
    env = {"HOME": home, "USER": pw.pw_name, "LOGNAME": pw.pw_name, "SHELL": pw.pw_shell or "/bin/bash",
           "PATH": task_path(home), "LANG": "C.UTF-8", "TERM": "dumb"}
    run_dir = f"/run/user/{os.getuid()}"
    if os.path.isdir(run_dir):
        env["XDG_RUNTIME_DIR"] = run_dir
        env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={run_dir}/bus"
    if task:
        env["SWARM_TASK_ID"] = task
    if timeout:
        env["SWARM_TASK_TIMEOUT"] = str(timeout)
    for pair in (task_env or "").split(","):
        # Per-task values from the runner (for example CLOZY_TEST_BASE=origin/main); agent.env below wins.
        k, _, v = pair.partition("=")
        if re.match(r"^[A-Z][A-Z0-9_]*$", k) and not k.startswith("SWARM_") and re.match(r"^[A-Za-z0-9][A-Za-z0-9._/-]*$", v):
            env[k] = v
    if agent_env and os.path.isfile(agent_env):
        # Root-owned extras for agents, for example a proxy base URL. KEY=VALUE lines.
        for line in open(agent_env):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                k = k.strip()
                if re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", k) and not k.startswith("SWARM_"):
                    env[k] = v.strip().strip('"').strip("'")
    return env


def user_systemd(env):
    if not shutil.which("systemd-run") or "XDG_RUNTIME_DIR" not in env:
        return False
    r = subprocess.run(["systemctl", "--user", "is-system-running"], env=env, capture_output=True, text=True)
    return r.stdout.strip() in ("running", "degraded")


def copy_in(src, dst):
    """Copy a regular file without following links."""
    try:
        fd = os.open(src, os.O_RDONLY | NOFOLLOW)
    except OSError:
        return False
    with os.fdopen(fd, "rb") as fin:
        if not os.path.isfile(src) or os.path.islink(src):
            return False
        with open(dst, "wb") as fout:
            shutil.copyfileobj(fin, fout)
    return True


def make_handoff_dir(path):
    """Make a folder inside the outbox and check it kept the group and setgid bit of its parent.

    Never chmod a folder made here: chmod by a user who is not in the folder's group (the agent is not in the
    runner's group) clears the setgid bit, and then the runner cannot read what the agent wrote (fixed in 0.2.1).
    The umask set in main() (0027) already gives mode 750.
    """
    os.makedirs(path, mode=0o750)
    parent = os.stat(os.path.dirname(path))
    st = os.stat(path)
    if parent.st_mode & 0o2000 and (st.st_gid != parent.st_gid or not st.st_mode & 0o2000):
        die(f"{path} did not get the group and setgid bit of its parent folder; check the outbox modes", 3)
    return path


def git(wd, *args, check=True):
    r = subprocess.run(GIT + list(args), cwd=wd, capture_output=True, text=True, env=clean_env())
    if check and r.returncode != 0:
        die(f"git {args[0]} failed: {(r.stderr or r.stdout).strip()[-400:]}", 3)
    return r


class Paths:
    def __init__(self, work, handoff):
        self.work = os.path.abspath(work)
        self.handoff = os.path.abspath(handoff)

    def wd(self, name):
        return os.path.join(self.work, check_name(name, "folder name"))

    def inbox(self, task):
        return os.path.join(self.handoff, "inbox", check_name(task, "task id"))

    def outbox(self, task):
        return os.path.join(self.handoff, "outbox", check_name(task, "task id"))

    def pidfile(self, task):
        d = os.path.join(self.work, ".swarm-pids")
        os.makedirs(d, mode=0o700, exist_ok=True)
        return os.path.join(d, check_name(task, "task id"))


def cmd_prepare(p, task, name, branch, origin, drop_checkpoint=False):
    wd, inbox = p.wd(name), p.inbox(task)
    if branch and not BRANCH_RE.match(branch):
        die("bad branch")
    state = "existing" if os.path.isdir(wd) else "fresh"
    restored = False
    if state == "fresh":
        os.makedirs(p.work, exist_ok=True)
        bundle = os.path.join(inbox, "repo.bundle")
        if os.path.isfile(bundle):
            git(p.work, "clone", "--quiet", bundle, wd)
            if origin:
                git(wd, "remote", "set-url", "origin", origin)
            if branch:
                if git(wd, "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{branch}", check=False).returncode == 0:
                    git(wd, "checkout", "--quiet", "-B", branch, f"refs/remotes/origin/{branch}")
                else:
                    git(wd, "checkout", "--quiet", "-b", branch)
            restore = os.path.join(inbox, "restore.bundle")
            if os.path.isfile(restore) and branch:
                # Unpushed work from an earlier run or from the parent task.
                if git(wd, "fetch", "--quiet", restore, "HEAD", check=False).returncode == 0:
                    git(wd, "checkout", "--quiet", "-B", branch, "FETCH_HEAD")
                    restored = True
        else:
            os.makedirs(wd)
    ctx = os.path.join(wd, ".task-context")
    os.makedirs(os.path.join(ctx, "attachments"), exist_ok=True)
    os.makedirs(os.path.join(wd, "artifacts"), exist_ok=True)
    if os.path.isdir(os.path.join(wd, ".git")):
        exclude = os.path.join(wd, ".git", "info", "exclude")
        os.makedirs(os.path.dirname(exclude), exist_ok=True)
        have = open(exclude).read() if os.path.exists(exclude) else ""
        with open(exclude, "a") as fh:
            for pat in (".task-context/", "AGENT_STATUS", "REPORT.md", "PR_DESCRIPTION.md", "CHECKPOINT.md", "artifacts/"):
                if pat not in have.split("\n"):
                    fh.write(pat + "\n")
    copy_in(os.path.join(inbox, "brief.md"), os.path.join(ctx, "brief.md"))
    att = os.path.join(inbox, "attachments")
    if os.path.isdir(att):
        for f in os.listdir(att):
            if NAME_RE.fullmatch(f):
                copy_in(os.path.join(att, f), os.path.join(ctx, "attachments", f))
    copy_in(os.path.join(inbox, "README"), os.path.join(ctx, "README"))
    par = os.path.join(inbox, "parent")
    if os.path.isdir(par):
        os.makedirs(os.path.join(ctx, "parent"), exist_ok=True)
        for f in os.listdir(par):
            if NAME_RE.fullmatch(f) and ".." not in f:
                copy_in(os.path.join(par, f), os.path.join(ctx, "parent", f))
    msg = os.path.join(ctx, "messages.md")
    if os.path.lexists(msg):
        os.remove(msg)
    os.symlink(os.path.join(inbox, "messages.md"), msg)
    # A chain cycle gets the last checkpoint as an attachment, so an old CHECKPOINT.md in a reused folder is dropped.
    for stale in ("AGENT_STATUS",) + (("CHECKPOINT.md",) if drop_checkpoint else ()):
        if os.path.lexists(os.path.join(wd, stale)):
            os.remove(os.path.join(wd, stale))
    for f in os.listdir(ctx):
        if f.startswith("session"):
            os.remove(os.path.join(ctx, f))
    head = git(wd, "rev-parse", "HEAD", check=False).stdout.strip() if os.path.isdir(os.path.join(wd, ".git")) else None
    print(json.dumps({"state": state, "restored": restored, "head": head or None, "git": head is not None}))


def cmd_run(p, task, name, timeout, scope, require_scope, memory, cpu, agent_env, command, task_env=None):
    wd = p.wd(name)
    if not os.path.isdir(wd):
        die("work folder is missing")
    env = clean_env(task, timeout, agent_env, task_env)
    for relative in ("AGENT_STATUS", ".task-context/activity-log.json"):
        path = os.path.join(wd, relative)
        if os.path.lexists(path):
            os.remove(path)
    cmd = [timeout_command(env["PATH"]), "--kill-after=30", str(int(timeout))] + command
    if scope:
        if user_systemd(env):
            cmd = ["systemd-run", "--user", "--scope", "--quiet", f"--unit=swarm-task-{task}-{int(time.time())}",
                   "--slice=swarm-tasks.slice", "-p", f"MemoryMax={memory}", "-p", f"CPUQuota={cpu}", "-p", "TasksMax=2048"] + cmd
        elif require_scope:
            die("per-task limits could not be applied: no systemd user manager for this user. "
                "Fix: sudo loginctl enable-linger agent (see docs/troubleshooting.md)", 70)
    proc = subprocess.Popen(cmd, cwd=wd, env=env, start_new_session=True)
    with open(p.pidfile(task), "w") as fh:
        fh.write(str(proc.pid))
    code = proc.wait()
    return 128 - code if code < 0 else code


def group_alive(pgid):
    try:
        os.killpg(pgid, 0)
        return True
    except OSError:
        return False


def cmd_stop(p, task, grace):
    env = clean_env()
    pattern = f"swarm-task-{check_name(task, 'task id')}-*.scope"
    has_sd = user_systemd(env)
    pgid = None
    try:
        pgid = int(open(p.pidfile(task)).read().strip())
    except (OSError, ValueError):
        pass
    if has_sd:
        subprocess.run(["systemctl", "--user", "kill", "--signal=SIGTERM", pattern], env=env, capture_output=True)
    if pgid and group_alive(pgid):
        os.killpg(pgid, signal.SIGTERM)
    end = time.time() + grace
    while time.time() < end and pgid and group_alive(pgid):
        time.sleep(0.5)
    if has_sd:
        subprocess.run(["systemctl", "--user", "kill", "--signal=SIGKILL", pattern], env=env, capture_output=True)
        subprocess.run(["systemctl", "--user", "stop", pattern], env=env, capture_output=True)
    if pgid and group_alive(pgid):
        os.killpg(pgid, signal.SIGKILL)


def cmd_stop_all(p):
    env = clean_env()
    if user_systemd(env):
        subprocess.run(["systemctl", "--user", "kill", "--signal=SIGKILL", "swarm-task-*.scope"], env=env, capture_output=True)
        subprocess.run(["systemctl", "--user", "stop", "swarm-task-*.scope"], env=env, capture_output=True)
    d = os.path.join(p.work, ".swarm-pids")
    if os.path.isdir(d):
        for f in os.listdir(d):
            try:
                pgid = int(open(os.path.join(d, f)).read().strip())
                if group_alive(pgid):
                    os.killpg(pgid, signal.SIGKILL)
            except (OSError, ValueError):
                pass


def safe_name(rel):
    name = re.sub(r"[^A-Za-z0-9._-]", "_", rel.replace(os.sep, "__"))
    name = name.lstrip("._-") or "file"
    return name[:120]


def cmd_collect(p, task, name):
    wd, out = p.wd(name), p.outbox(task)
    if os.path.lexists(out):
        if os.path.islink(out) or not os.path.isdir(out):
            os.remove(out)
        else:
            shutil.rmtree(out)
    make_handoff_dir(out)
    summary = {"files": {}}
    for src, dst in (("REPORT.md", "REPORT.md"), ("AGENT_STATUS", "AGENT_STATUS"), ("PR_DESCRIPTION.md", "PR_DESCRIPTION.md"),
                     ("CHECKPOINT.md", "CHECKPOINT.md"), (".task-context/activity-log.json", "activity-log.json"),
                     (".task-context/session-claude", "session-claude"), (".task-context/session-codex", "session-codex"),
                     (".task-context/session", "session")):
        path = os.path.join(wd, src)
        limit = 4096 if dst == "activity-log.json" else MAX_ARTIFACT
        if os.path.lexists(path) and not os.path.islink(path) and os.path.isfile(path) and os.path.getsize(path) <= limit:
            if copy_in(path, os.path.join(out, dst)):
                summary["files"][dst] = int(os.lstat(path).st_mtime)
    # Artifacts: regular files only, unique flat names, every omission listed.
    art, adir = os.path.join(wd, "artifacts"), os.path.join(out, "artifacts")
    make_handoff_dir(adir)
    manifest, omitted, used = [], [], set()
    if os.path.isdir(art) and not os.path.islink(art):
        for root, dirs, files in os.walk(art, followlinks=False):
            dirs.sort()
            for d in list(dirs):
                if os.path.islink(os.path.join(root, d)):
                    omitted.append({"path": os.path.relpath(os.path.join(root, d), art), "why": "link to a folder"})
                    dirs.remove(d)
            for f in sorted(files):
                full = os.path.join(root, f)
                rel = os.path.relpath(full, art)
                st = os.lstat(full)
                if os.path.islink(full):
                    omitted.append({"path": rel, "why": "symbolic link"})
                    continue
                if not os.path.isfile(full):
                    omitted.append({"path": rel, "why": "not a regular file"})
                    continue
                if st.st_size > MAX_ARTIFACT:
                    omitted.append({"path": rel, "why": "larger than 25 MB"})
                    continue
                if len(manifest) >= MAX_ARTIFACTS:
                    omitted.append({"path": rel, "why": f"over the {MAX_ARTIFACTS}-file limit"})
                    continue
                base, n = safe_name(rel), 2
                uname = base
                while uname.lower() in used:
                    stem, dot, ext = base.rpartition(".")
                    uname = (f"{stem}-{n}.{ext}" if dot and stem else f"{base}-{n}")[:120]
                    n += 1
                used.add(uname.lower())
                if copy_in(full, os.path.join(adir, uname)):
                    manifest.append({"name": uname, "path": rel, "size": st.st_size})
    summary["artifacts"] = manifest
    summary["omitted"] = omitted
    # Git: bundle every commit that is not on the remote yet, so nothing is lost and the runner can publish it.
    if os.path.isdir(os.path.join(wd, ".git")):
        head = git(wd, "rev-parse", "HEAD", check=False).stdout.strip()
        branch = git(wd, "rev-parse", "--abbrev-ref", "HEAD", check=False).stdout.strip()
        dirty = [ln for ln in git(wd, "status", "--porcelain", check=False).stdout.splitlines() if ln.strip()]
        count = git(wd, "rev-list", "--count", "HEAD", "--not", "--remotes", check=False).stdout.strip() if head else "0"
        unpushed = int(count) if count.isdigit() else 0
        bundled = False
        if unpushed:
            bundled = git(wd, "bundle", "create", "--quiet", os.path.join(out, "work.bundle"), "HEAD", "--not", "--remotes",
                          check=False).returncode == 0
        summary["git"] = {"head": head or None, "branch": branch or None, "unpushed": unpushed, "bundled": bundled,
                          "uncommitted": len(dirty)}
    # Files only. Folders keep the mode they were made with (see make_handoff_dir).
    for root, dirs, files in os.walk(out):
        for f in files:
            os.chmod(os.path.join(root, f), 0o640)
    with open(os.path.join(out, "summary.json"), "w") as fh:
        json.dump(summary, fh)
    os.chmod(os.path.join(out, "summary.json"), 0o640)
    print(json.dumps(summary))


def cmd_cleanup(p, task):
    """Remove HANDOFF/outbox/TASK after the runner has saved the results. Only that one folder.

    The agent made the folder, so only the agent can remove it; the runner asks through this narrow action
    instead of getting any power over the agent's files. The task id is checked (no slashes, no "..", no
    leading dot), and a link anywhere on the way is refused, never followed. A missing folder is fine.
    The runner removes HANDOFF/inbox/TASK itself: it owns that folder.
    """
    root = os.path.join(p.handoff, "outbox")
    try:
        rst = os.lstat(root)
    except FileNotFoundError:
        return 0
    if not stat.S_ISDIR(rst.st_mode):
        die(f"{root} is not a real folder; nothing removed", 3)
    target = p.outbox(task)   # check_name rejects path tricks
    if os.path.dirname(target) != root:
        die("bad task id", 2)
    try:
        st = os.lstat(target)
    except FileNotFoundError:
        return 0
    if stat.S_ISLNK(st.st_mode):
        die(f"{target} is a link; refusing to remove it", 3)
    if not stat.S_ISDIR(st.st_mode):
        die(f"{target} is not a folder; refusing to remove it", 3)
    if os.path.realpath(target) != os.path.join(os.path.realpath(root), task):
        die(f"{target} is not inside the outbox; refusing", 3)
    # shutil.rmtree works with folder handles on Linux and never follows links inside the tree.
    if not shutil.rmtree.avoids_symlink_attacks:
        die("this Python cannot remove folders safely; nothing removed", 3)
    shutil.rmtree(target)
    print(json.dumps({"removed": target}))
    return 0


# ---------- orchestrators: one long-lived agent session in tmux per name ----------
# The folder is WORK/orchestrators/NAME (task cleanup skips it). Each orchestrator has its own tmux server
# (socket swarm-orch-NAME) and, when the agent has a systemd user manager, its own scope swarm-orch-NAME-*.scope,
# so neither a runner restart (stop-all only stops swarm-task-*) nor a supervisor restart touches the session.
ORCH_RE = re.compile(r"^[a-z0-9][a-z0-9-]{1,31}$")


def orch_name(name):
    if not ORCH_RE.fullmatch(name or ""):
        die(f"bad orchestrator name: {name!r}")
    return name


def orch_wd(p, name):
    return os.path.join(p.work, "orchestrators", orch_name(name))


def orch_inbox(p, name):
    return os.path.join(p.handoff, "inbox", "orch-" + orch_name(name))


def tmux(name, *args, env=None, check=False, **kw):
    r = subprocess.run(["tmux", "-L", f"swarm-orch-{name}"] + list(args), env=env or clean_env(), capture_output=True, text=True, **kw)
    if check and r.returncode != 0:
        die(f"tmux {args[0]} failed: {(r.stderr or r.stdout).strip()[-300:]}", 3)
    return r


def orch_alive(name):
    return tmux(name, "has-session", "-t", f"orch-{name}").returncode == 0


def cmd_orch_prepare(p, name, origin):
    """Make the folder once (cloned from the runner's bundle when there is a repo) and copy in the brief and prompts."""
    wd, inbox = orch_wd(p, name), orch_inbox(p, name)
    state = "existing" if os.path.isdir(wd) else "fresh"
    if state == "fresh":
        os.makedirs(os.path.dirname(wd), exist_ok=True)
        bundle = os.path.join(inbox, "repo.bundle")
        if os.path.isfile(bundle):
            git(os.path.dirname(wd), "clone", "--quiet", bundle, wd)
            if origin:
                git(wd, "remote", "set-url", "origin", origin)
        else:
            os.makedirs(wd)
    ctx = os.path.join(wd, ".orchestrator")
    os.makedirs(ctx, exist_ok=True)
    for f in ("brief.md", "start.md", "resume.md", "stop.md"):
        if os.path.isfile(os.path.join(inbox, f)):
            dst = os.path.join(ctx, f)
            if os.path.lexists(dst):
                os.remove(dst)
            copy_in(os.path.join(inbox, f), dst)
    with open(os.path.join(ctx, "tmux.conf"), "w") as fh:
        # remain-on-exit keeps a finished pane so the supervisor can read the exit status before it cleans up.
        fh.write("set -g remain-on-exit on\nset -g history-limit 5000\nset -g status off\n")
    if os.path.isdir(os.path.join(wd, ".git")):
        exclude = os.path.join(wd, ".git", "info", "exclude")
        os.makedirs(os.path.dirname(exclude), exist_ok=True)
        have = open(exclude).read() if os.path.exists(exclude) else ""
        with open(exclude, "a") as fh:
            for pat in (".orchestrator/", "CHECKPOINT.md", "HANDOVER.md"):
                if pat not in have.split("\n"):
                    fh.write(pat + "\n")
    print(json.dumps({"state": state, "folder": wd}))


def orch_env(name, agent_env, relay_name):
    env = clean_env(agent_env=agent_env)
    env.update(TERM="xterm-256color", SWARM_ORCHESTRATOR=name)
    if relay_name:
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{1,63}", relay_name):
            die("bad relay name")
        env["SWARM_RELAY_AGENT_NAME"] = relay_name
    return env


def cmd_orch_start(p, name, agent_env, bundles, with_secrets, relay_name, scope, command):
    wd = orch_wd(p, name)
    if not os.path.isdir(wd):
        die("orchestrator folder is missing; run orch-prepare first")
    if orch_alive(name):
        die(f"orch-{name} is already running", 4)
    env = orch_env(name, agent_env, relay_name)
    names = [b for b in (bundles or "").split(",") if b]
    if names:
        if not all(re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", b) for b in names):
            die("bad secret bundle name")
        ws = with_secrets or shutil.which("with-secrets", path=env["PATH"]) or os.path.join(os.path.dirname(os.path.realpath(__file__)), "with-secrets")
        # Names only: with-secrets refuses a bundle this worker has not synced (admin bundles never are). Output is dropped.
        if subprocess.run([ws, "--check"] + names, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
            die("a secret bundle is not available on this worker: " + ", ".join(names), 5)
        command = [ws] + names + ["--"] + command
    cmd = ["tmux", "-L", f"swarm-orch-{name}", "-f", os.path.join(wd, ".orchestrator", "tmux.conf"),
           "new-session", "-d", "-s", f"orch-{name}", "-x", "220", "-y", "50", "-c", wd, "--"] + command
    if scope and user_systemd(env):
        cmd = ["systemd-run", "--user", "--scope", "--quiet", f"--unit=swarm-orch-{name}-{int(time.time())}",
               "--slice=swarm-orchestrators.slice"] + cmd
    r = subprocess.run(cmd, cwd=wd, env=env, capture_output=True, text=True)
    if r.returncode != 0:
        die(f"tmux did not start: {(r.stderr or r.stdout).strip()[-300:]}", 3)
    pid = tmux(name, "list-panes", "-t", f"orch-{name}", "-F", "#{pane_pid}", env=env).stdout.strip()
    print(json.dumps({"started": True, "pid": int(pid) if pid.isdigit() else None}))


def claude_session(wd, sessions_dir=None):
    """Claude Code keeps each session as ~/.claude/projects/<folder with every other character as ->/<session id>.jsonl."""
    base = sessions_dir or os.path.join(pwd.getpwuid(os.getuid()).pw_dir, ".claude", "projects")
    d = os.path.join(base, re.sub(r"[^A-Za-z0-9]", "-", wd))
    try:
        files = [(os.lstat(os.path.join(d, f)).st_mtime, f[:-6]) for f in os.listdir(d) if f.endswith(".jsonl")]
    except OSError:
        return None
    files = [x for x in files if re.fullmatch(r"[A-Za-z0-9_-]{1,100}", x[1])]
    return max(files)[1] if files else None


def cmd_orch_status(p, name, lines, sessions_dir):
    wd = orch_wd(p, name)
    out = {"alive": orch_alive(name), "dead": False, "exit": None, "pid": None, "tail": None,
           "session_id": claude_session(wd, sessions_dir), "checkpoint_at": None}
    ck = os.path.join(wd, "CHECKPOINT.md")
    if os.path.isfile(ck) and not os.path.islink(ck):
        out["checkpoint_at"] = int(os.lstat(ck).st_mtime)
    if out["alive"]:
        info = tmux(name, "list-panes", "-t", f"orch-{name}", "-F", "#{pane_pid} #{pane_dead} #{pane_dead_status}").stdout.split()
        if info:
            out["pid"] = int(info[0]) if info[0].isdigit() else None
            out["dead"] = len(info) > 1 and info[1] == "1"
            out["exit"] = int(info[2]) if len(info) > 2 and info[2].lstrip("-").isdigit() else None
        if lines:
            out["tail"] = tmux(name, "capture-pane", "-p", "-J", "-t", f"orch-{name}", "-S", f"-{int(lines)}").stdout
        # Only what is on the screen now, so a sign-in or first-run screen that scrolled away is not seen again.
        out["screen"] = tmux(name, "capture-pane", "-p", "-J", "-t", f"orch-{name}").stdout
    print(json.dumps(out))


# ---------- the pane parser (one copy: swarm_orchestrator.py loads these functions from this file) ----------
# Claude Code's input box, read from the bottom of a plain `tmux capture-pane`. Simple rules that fail closed: anything
# this does not positively recognize is a draft, an unknown footer or unreadable, and nothing is typed onto it.
PANE_RULE = re.compile(r"^\s*[╭╰]?[─━═]{8,}[╮╯]?\s*$")   # a border line of the input box (plain or rounded)
PANE_PROMPT = re.compile(r"^[\s│┃|]*[>❯](?:\s|$)")
PANE_MENU = re.compile(r"^[\s│┃|]*❯\s*\d+[.)]\s|(?:Esc|Enter) to (?:cancel|select|confirm)", re.I)
PANE_PASTED = re.compile(r"^\[Pasted text #\d+(?: \+\d+ lines?)?\]$")   # Claude Code's placeholder for a collapsed paste
PANE_FOOTER_MAX = 8      # non-blank rows Claude Code shows under the input box
PANE_ROWS_MAX = 20       # rows of a multiline input box
# Claude Code's own hint on the prompt row of an empty box, as seen in real captures. Exact literals only.
PANE_HINTS = frozenset({"Press up to edit queued messages"})
# Every row under the input box is one or more status items (separated by two or more spaces, as Claude Code lays out
# its left and right columns), and each item must match one of these whole, as seen in real captures. The only variable
# fields are explicit: the permission mode, the auto-update failure reason (lower-case words) and the effort level.
PANE_FOOTER_ITEMS = [re.compile(p) for p in (
    r"(?:⏵⏵ (?:bypass permissions|accept edits)|⏸ plan mode) on \(shift\+tab to cycle\)(?: · (?:esc to interrupt|← for agents))*",
    r"\? for shortcuts",
    r"paste again to expand",
    r"esc to interrupt",
    r"Press Ctrl-[CD] again to exit",
    r"Not logged in · Run /login",
    r"✘ Auto-update failed: [a-z][a-z ]{0,80} · Run claude doctor",
    r"✓ Update installed(?: · Restart to apply)?",
    r"tmux focus-events off · add 'set -g focus-events on' to ~/\.tmux\.conf and reattach for focus tracking",
    r"[◐◑◒◓○●] (?:low|medium|high|xhigh|max) · /effort",
)]


def pane_lines(screen):
    lines = [ln.rstrip() for ln in (screen or "").splitlines()]
    while lines and not lines[-1].strip():
        lines.pop()
    return lines


def pane_footer_row(line):
    """True when this row under the input box is made only of known Claude Code status items."""
    items = re.split(r"\s{2,}", line.strip())
    return bool(items) and all(any(p.fullmatch(it) for p in PANE_FOOTER_ITEMS) for it in items)


def pane_box(screen):
    """Claude Code's input box at the bottom of the pane: {"state", "rows", "footer_ok", "bottom"}.

    state: "empty" (one prompt row, blank or a verified hint, and a valid footer), "draft" (anything typed, or a box that
    cannot be told apart from text inside a bigger one), "unknown_footer" (an empty box over rows that are not all known
    status items), or None (no box at the bottom). rows: the box's rows (prompt marker and side bars removed, nothing
    else changed) only for one unambiguous box; footer_ok: 1 to PANE_FOOTER_MAX rows under it, every one known.

    Read from the bottom: the last rule is the box's bottom, the nearest rule above it (at most PANE_ROWS_MAX rows up)
    its top, and the first row under the top must be the prompt. The box is ambiguous, so a draft, when the rules differ
    or anywhere higher on the screen another prompt line sits right under a rule (the top may be a rule pasted inside a
    taller draft whose real top is higher up)."""
    lines = pane_lines(screen)
    out = {"state": None, "rows": None, "footer_ok": False, "bottom": None, "top": None}
    bot = next((i for i in range(len(lines) - 1, -1, -1) if PANE_RULE.match(lines[i])), None)
    if not bot:
        return out
    footer = [ln for ln in lines[bot + 1:] if ln.strip()]
    if any(PANE_PROMPT.match(ln) for ln in footer):
        return out   # a prompt under the last rule: not a box at the bottom of the pane
    out["bottom"] = bot
    out["footer_ok"] = 1 <= len(footer) <= PANE_FOOTER_MAX and all(pane_footer_row(ln) for ln in footer)
    top = next((i for i in range(bot - 1, max(-1, bot - 2 - PANE_ROWS_MAX), -1) if PANE_RULE.match(lines[i])), None)
    if top is None:
        return out
    if any(PANE_RULE.match(lines[i]) and PANE_PROMPT.match(lines[i + 1]) for i in range(top)):
        out["state"] = "draft"   # two candidate boxes
        return out
    rows = lines[top + 1:bot]
    if not rows or not PANE_PROMPT.match(rows[0]):
        return out
    out["top"] = top
    t, b = lines[top], lines[bot]
    if t.lstrip().startswith("╭") and b.lstrip().startswith("╰"):
        inner = [r.strip() for r in rows]
        if len(t.strip()) != len(b.strip()) or not all(len(r) >= 2 and r[0] == "│" and r[-1] == "│" for r in inner):
            out["state"] = "draft"
            return out
        rows = [r[1:-1] for r in inner]
    elif t != b or t[:1] not in "─━═":
        out["state"] = "draft"   # an indented or different rule: possibly one pasted inside a draft
        return out
    rows[0] = re.sub(r"^\s*[>❯]", "", rows[0], count=1)
    out["rows"] = rows
    empty = len(rows) == 1 and (not rows[0].strip() or rows[0].strip() in PANE_HINTS)
    out["state"] = "draft" if not empty else "empty" if out["footer_ok"] else "unknown_footer"
    return out


def pane_menu(screen):
    """True when a choice menu or permission prompt is on screen (a selected numbered option, or its key hints).
    With a box at the bottom only its footer can hold active controls: output above it is history, the box is data."""
    lines = pane_lines(screen)
    box = pane_box(screen)
    scope = lines[box["bottom"] + 1:] if box["state"] is not None else lines
    return any(PANE_MENU.search(ln) for ln in [ln for ln in scope if ln.strip()][-25:])


def pane_cells(s):
    """Terminal cells a string takes (wide characters count two)."""
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def pane_nows(s):
    return "".join(str(s or "").split())


def pane_plain_last(screen):
    lines = [ln.strip() for ln in pane_lines(screen) if ln.strip()]
    return lines[-1] if lines else None


def editor_check(screen, line, plain=False):
    """After typing one line, before its Enter: None when the live editor holds exactly that line, else "not_landed".
    The editor is the one unambiguous input box at the bottom (pane_box) over a known footer, with no menu. Its rows are
    compared as data with whitespace runs collapsed to one space; a row filled to the editor width (Claude Code wraps a
    long line itself, at 80 columns too) may join the next row without a space. plain: a box-less test stand-in whose
    last non-blank line is the echo of what was typed."""
    want = " ".join(str(line or "").split())
    if not want:
        return "not_landed"
    if plain:
        return None if pane_plain_last(screen) == want else "not_landed"
    if not screen or pane_menu(screen):
        return "not_landed"
    box = pane_box(screen)
    if box["rows"] is None or not box["footer_ok"] or box["top"] is None:
        return "not_landed"
    lines = pane_lines(screen)
    width = pane_cells(lines[box["bottom"]].strip())
    raw = [lines[box["top"] + 1]] + list(box["rows"][1:])
    if lines[box["top"]].lstrip().startswith("╭"):
        width -= 2
        raw[0] = box["rows"][0]
    else:
        raw[0] = re.sub(r"^(\s*)[>❯]", lambda m: m.group(1) + " ", raw[0], count=1)
    segs = []   # [collapsed text, row filled to the editor width]
    for t in raw:
        c = " ".join(t.split())
        if c:
            segs.append([c, pane_cells(t.rstrip()) >= width - 2])
        elif segs:
            segs[-1][1] = False   # a blank row between two rows always means whitespace
    if segs:
        pattern = re.escape(segs[0][0]) + "".join((" ?" if prev[1] else " ") + re.escape(cur[0])
                                                  for prev, cur in zip(segs, segs[1:]))
        if re.fullmatch(pattern, want):
            return None
    return "not_landed"


def editor_text(screen, plain=False):
    """What the live editor holds, whitespace removed ("" when empty), or None when it cannot be read."""
    if plain:
        return None
    box = pane_box(screen)
    if box["rows"] is None or not box["footer_ok"]:
        return None
    text = pane_nows(" ".join(box["rows"]))
    return "" if text in {pane_nows(h) for h in PANE_HINTS} else text


def shown_above_editor(screen, line, plain=False):
    """How often the line shows above the live editor (the conversation, or Claude Code's queued-message list while busy;
    compared without whitespace, as both wrap and indent it), or None when the editor cannot be located. plain: lines
    above the last one that are exactly the line."""
    want = pane_nows(line)
    if not want:
        return 0
    lines = pane_lines(screen)
    if plain:
        body = [ln.strip() for ln in lines if ln.strip()]
        return sum(1 for ln in body[:-1] if ln == " ".join(str(line).split()))
    box = pane_box(screen)
    if box["top"] is None or not box["footer_ok"]:
        return None
    return pane_nows("\n".join(lines[:box["top"]])).count(want)


def submitted_in_pane(screen, line, before=0, plain=False):
    """After Enter: True when the editor is located, no longer holds the line, and the line (a pointer names its unique
    message id) shows above it more often than before this attempt typed it. Claude Code's generic "Press up to edit
    queued messages" hint is not evidence for this line."""
    n = shown_above_editor(screen, line, plain)
    return n is not None and editor_check(screen, line, plain) is not None and n > int(before or 0)


TYPE_TIMEOUT, CONFIRM_TIMEOUT, TYPE_STEP = 2.0, 5.0, 0.1   # seconds to see the typed line, then its submission


def type_line(drv, line, plain=False):
    """Type one line as literal keys into the (already verified empty) editor and wait until the editor holds exactly it.
    Returns "ok", "nothing" (no key went in, the editor is still empty), "erased" (not landed; our partial text was
    removed again) or "left" (not landed and something may remain: a menu, unreadable, or text that is not only ours).
    drv: capture() -> screen, type(text) -> bool, keys(*keys) -> bool, sleep(s), now()."""
    ok = drv.type(line)
    end = drv.now() + TYPE_TIMEOUT
    while True:
        screen = drv.capture()
        if editor_check(screen, line, plain) is None:
            return "ok"
        if drv.now() >= end:
            break
        drv.sleep(TYPE_STEP)
    held = editor_text(screen, plain)
    if held == "" and not pane_menu(screen):
        return "nothing" if not ok else "erased"
    if held is None or pane_menu(screen) or not pane_nows(line).startswith(held):
        return "left"
    drv.keys(*["BSpace"] * (len(line) + 2))
    return "erased" if editor_text(drv.capture(), plain) == "" else "left"


def enter_line(drv, line, before=0, plain=False):
    """Press Enter for a typed line, only while a fresh capture shows the live editor holds exactly it, then confirm from
    the same pane: "submitted", "in_editor" (still there), "unknown", "not_in_editor" (no Enter) or "enter_failed"."""
    if editor_check(drv.capture(), line, plain) is not None:
        return "not_in_editor"
    if not drv.keys("Enter"):
        return "enter_failed"
    end = drv.now() + CONFIRM_TIMEOUT
    while True:
        screen = drv.capture()
        if submitted_in_pane(screen, line, before, plain):
            return "submitted"
        if drv.now() >= end:
            return "in_editor" if editor_check(screen, line, plain) is None else "unknown"
        drv.sleep(TYPE_STEP)


class PaneDriver:
    """tmux on one pane, by its ID (%N): every capture and key of one attempt goes to that pane only."""

    def __init__(self, name, pane):
        self.name, self.pane = name, pane

    def capture(self):
        r = tmux(self.name, "capture-pane", "-p", "-J", "-t", self.pane, "-S", "-200")
        return r.stdout if r.returncode == 0 else ""

    def type(self, text):
        return tmux(self.name, "send-keys", "-t", self.pane, "-l", text).returncode == 0

    def keys(self, *keys):
        return tmux(self.name, "send-keys", "-t", self.pane, *keys).returncode == 0

    def sleep(self, s):
        time.sleep(s)

    def now(self):
        return time.monotonic()


def orch_pane(name, pane=None):
    """The pane ID (%N) of the session's active pane (or the given one, checked), or None."""
    r = tmux(name, "display-message", "-p", "-t", pane or f"orch-{name}:", "#{pane_id}")
    got = r.stdout.strip() if r.returncode == 0 else ""
    return got if re.fullmatch(r"%\d+", got) and (pane is None or got == pane) else None


def orch_line(p, name):
    """The one line to type (inbox line.txt): printable, no newline or tab, at most 1000 characters."""
    try:
        fd = os.open(os.path.join(orch_inbox(p, name), "line.txt"), os.O_RDONLY | NOFOLLOW)
    except OSError:
        die("no line.txt in the inbox", 5)
    with os.fdopen(fd, encoding="utf-8", errors="replace") as fh:
        line = fh.read(2000).rstrip("\n")
    if not line or len(line) > 1000 or not line.isprintable():
        die("line.txt must be one printable line", 5)
    return line


INBOX_KEEP, INBOX_DAYS = 200, 7   # message files kept for the agent to re-read


def orch_message_file(p, name, mid):
    """Copy inbox message.md to the session's .orchestrator/inbox/msg-ID.md (0600, atomic), inside the session's folder
    so Claude reads it without a permission prompt. Older files beyond INBOX_KEEP or INBOX_DAYS are removed."""
    src = os.path.join(orch_inbox(p, name), "message.md")
    d = os.path.join(orch_wd(p, name), ".orchestrator", "inbox")
    os.makedirs(d, exist_ok=True)
    fd = os.open(src, os.O_RDONLY | NOFOLLOW)
    with os.fdopen(fd, encoding="utf-8", errors="replace") as fh:
        text = fh.read()
    path, tmp = os.path.join(d, f"msg-{mid}.md"), os.path.join(d, f".msg-{mid}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)
    try:
        files = sorted((os.path.join(d, f) for f in os.listdir(d) if re.fullmatch(r"msg-\d+\.md", f)),
                       key=os.path.getmtime, reverse=True)
        for i, f in enumerate(files):
            if f != path and (i >= INBOX_KEEP or time.time() - os.path.getmtime(f) > INBOX_DAYS * 86400):
                os.remove(f)
    except OSError:
        pass
    return path


def cmd_orch_capture(p, name, pane):
    orch_name(name)
    got = orch_pane(name, pane)
    screen = PaneDriver(name, got).capture() if got else ""
    print(json.dumps({"pane": got, "screen": screen}))


def cmd_orch_type(p, name, pane, mid, plain=False):
    orch_name(name)
    line = orch_line(p, name)
    if not pane or orch_pane(name, pane) != pane:
        die("the pane is gone", 5)
    if mid is not None:
        if not str(mid).isdigit():
            die("bad message id")
        try:
            orch_message_file(p, name, int(mid))
        except OSError as e:
            die(f"message file not written: {type(e).__name__}", 5)
    out = type_line(PaneDriver(name, pane), line, plain)
    print(json.dumps({"typed": out}))
    return {"ok": 0, "nothing": 5, "erased": 8}.get(out, 9)


def cmd_orch_enter(p, name, pane, before, plain=False):
    orch_name(name)
    line = orch_line(p, name)
    if not pane or orch_pane(name, pane) != pane:
        print(json.dumps({"state": "not_in_editor"}))
        return 0
    print(json.dumps({"state": enter_line(PaneDriver(name, pane), line, int(before or 0), plain)}))
    return 0


def cmd_orch_kill(p, name):
    orch_name(name)
    env = clean_env()
    tmux(name, "kill-server")
    if user_systemd(env):
        subprocess.run(["systemctl", "--user", "stop", f"swarm-orch-{name}-*.scope"], env=env, capture_output=True)
    print(json.dumps({"alive": orch_alive(name)}))


ORCH_KEYS = ("Enter", "Down", "Up", "Escape") + tuple(str(i) for i in range(1, 10))


def cmd_orch_keys(p, name, keys):
    """Press a few named keys, to answer one of Claude Code's first-run screens. Never free text."""
    if not keys or len(keys) > 4 or any(k not in ORCH_KEYS for k in keys):
        die("orch-keys takes 1 to 4 of: " + " ".join(ORCH_KEYS))
    if not orch_alive(orch_name(name)):
        die(f"orch-{name} is not running", 4)
    for k in keys:
        tmux(name, "send-keys", "-t", f"orch-{name}", k, check=True)
        time.sleep(0.3)
    print(json.dumps({"sent": keys}))


CLAUDE_TOKEN_VARS = ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")


def cmd_orch_check(p, name, agent_env, claude_dir=None):
    """Before a start: does Claude Code have a sign-in for this user? Says how, never the value.

    logged_in is true (a token in agent.env, a proxy, an apiKeyHelper or a saved /login), false (none of those), or
    null on a Mac without any of them, where a /login lives in the Keychain and cannot be checked from here."""
    orch_name(name)
    env = clean_env(agent_env=agent_env)
    cdir = claude_dir or os.path.join(env["HOME"], ".claude")
    how = next((f"{k} in the agent environment" for k in CLAUDE_TOKEN_VARS if env.get(k)), None)
    if not how and env.get("ANTHROPIC_BASE_URL"):
        how = "a proxy (ANTHROPIC_BASE_URL) in the agent environment"
    if not how:
        try:
            if os.path.getsize(os.path.join(cdir, ".credentials.json")) > 2:
                how = "a saved /login"
        except OSError:
            pass
    if not how:
        try:
            with open(os.path.join(cdir, "settings.json")) as fh:
                if json.load(fh).get("apiKeyHelper"):
                    how = "an apiKeyHelper in Claude's settings"
        except (OSError, ValueError, AttributeError):
            pass
    logged_in = True if how else (None if sys.platform == "darwin" else False)
    print(json.dumps({"logged_in": logged_in, "how": how}))


def cmd_orch_relay(p, name, agent_env, relay_name, command):
    """Run the Relay registration command for this fixed name. Its output may hold a token, so none of it is kept."""
    wd = orch_wd(p, name)
    env = orch_env(name, agent_env, relay_name)
    try:
        return subprocess.run(command, cwd=wd if os.path.isdir(wd) else p.work, env=env, stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120).returncode
    except (OSError, subprocess.SubprocessError):
        return 127


def main(argv):
    work = handoff = None
    while argv and argv[0].startswith("--"):
        if argv[0] == "--work":
            work, argv = argv[1], argv[2:]
        elif argv[0] == "--handoff":
            handoff, argv = argv[1], argv[2:]
        elif argv[0] == "--version":
            print(VERSION)
            return 0
        else:
            die(f"unknown option {argv[0]}")
    if not argv or not work or not handoff:
        die("usage: agent-exec --work DIR --handoff DIR COMMAND ... (see the top of this file)")
    os.umask(0o027)
    p = Paths(work, handoff)
    cmd, rest = argv[0], argv[1:]
    opts, positional, command = {}, [], []
    if "--" in rest:
        i = rest.index("--")
        rest, command = rest[:i], rest[i + 1:]
    it = iter(rest)
    for a in it:
        if a in ("--scope", "--require-scope", "--drop-checkpoint", "--plain"):
            opts[a] = True
        elif a.startswith("--"):
            opts[a] = next(it, None)
        else:
            positional.append(a)
    if cmd == "prepare" and len(positional) == 2:
        cmd_prepare(p, positional[0], positional[1], opts.get("--branch"), opts.get("--origin"), opts.get("--drop-checkpoint", False))
    elif cmd == "run" and len(positional) == 2 and command:
        return cmd_run(p, positional[0], positional[1], int(opts.get("--timeout") or 14400), opts.get("--scope", False),
                       opts.get("--require-scope", False), opts.get("--memory") or "75%", opts.get("--cpu") or "200%",
                       opts.get("--agent-env"), command, opts.get("--task-env"))
    elif cmd == "stop" and len(positional) == 1:
        cmd_stop(p, positional[0], float(opts.get("--grace") or 20))
    elif cmd == "stop-all":
        cmd_stop_all(p)
    elif cmd == "collect" and len(positional) == 2:
        cmd_collect(p, positional[0], positional[1])
    elif cmd == "cleanup" and len(positional) == 1 and not opts and not command:
        return cmd_cleanup(p, positional[0])
    elif cmd == "exists" and len(positional) == 1:
        return 0 if os.path.isdir(p.wd(positional[0])) else 1
    elif cmd == "orch-prepare" and len(positional) == 1:
        cmd_orch_prepare(p, positional[0], opts.get("--origin"))
    elif cmd == "orch-start" and len(positional) == 1 and command:
        cmd_orch_start(p, positional[0], opts.get("--agent-env"), opts.get("--secrets"), opts.get("--with-secrets"),
                       opts.get("--relay-name"), opts.get("--scope", False), command)
    elif cmd == "orch-status" and len(positional) == 1:
        cmd_orch_status(p, positional[0], int(opts.get("--lines") or 0), opts.get("--sessions-dir"))
    elif cmd == "orch-capture" and len(positional) == 1 and not command:
        cmd_orch_capture(p, positional[0], opts.get("--pane"))
    elif cmd == "orch-type" and len(positional) == 1 and not command:
        return cmd_orch_type(p, positional[0], opts.get("--pane"), opts.get("--id"), opts.get("--plain", False))
    elif cmd == "orch-enter" and len(positional) == 1 and not command:
        return cmd_orch_enter(p, positional[0], opts.get("--pane"), opts.get("--before"), opts.get("--plain", False))
    elif cmd == "orch-kill" and len(positional) == 1:
        cmd_orch_kill(p, positional[0])
    elif cmd == "orch-keys" and len(positional) >= 2 and not opts and not command:
        cmd_orch_keys(p, positional[0], positional[1:])
    elif cmd == "orch-check" and len(positional) == 1 and not command:
        cmd_orch_check(p, positional[0], opts.get("--agent-env"), opts.get("--claude-dir"))
    elif cmd == "orch-relay" and len(positional) == 1 and command:
        return cmd_orch_relay(p, positional[0], opts.get("--agent-env"), opts.get("--relay-name"), command)
    elif cmd == "exec" and len(positional) == 1 and command:
        wd = p.wd(positional[0]) if positional[0] != "." else p.work
        return subprocess.run(command, cwd=wd, env=clean_env(agent_env=opts.get("--agent-env"))).returncode
    else:
        die(f"bad command line for {cmd!r}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
