#!/usr/bin/env python3
"""swarmctl: command line for the swarm backend. Bots, people and scripts all use this.

Settings come from the environment or ~/.config/swarm/client.env (KEY=VALUE lines):
  SWARM_URL         backend address, for example https://YOUR-WORKER.YOUR-TAILNET.ts.net
  SWARM_TOKEN_FILE  file holding your token (default ~/.config/swarm/client.token). Never paste tokens in chat.

Examples:
  swarmctl status
  swarmctl enqueue -p website --owner website-bot --pr brief.md
  swarmctl enqueue --owner website-bot --report-only --key seo-audit-2026-01 brief.md
  swarmctl enqueue -r you/app --command "npm ci && npm test" --owner app-bot - <<< "Run the full test suite"
  swarmctl enqueue --follow-up TASK_ID brief.md        continue earlier work (same repo, branch and folder)
  swarmctl review -r you/app --pr-number 12 -P codex --owner app-bot
  swarmctl list --state waiting
  swarmctl show TASK_ID ; swarmctl report TASK_ID
  swarmctl answer TASK_ID "Use the blue logo"
  swarmctl message TASK_ID "Also update the footer"
  swarmctl waiting list
  swarmctl waiting add --project website --bot website-bot --kind decision --ask "Ship the new homepage?" \\
      --rec "Ship it" --link https://example.com/preview --key homepage-v2
  swarmctl project set website --repo you/site --bot website-bot
  swarmctl bot set website-bot --notify-url https://example.com/hooks/website --notify-auth-file ~/.config/swarm/website.hook
  swarmctl bot test website-bot
  swarmctl log add marketing --kind feedback --by Sam "Too formal. Write like we talk to customers."
  swarmctl log add marketing --kind item --status needs-review "Spring sale ad, Facebook"
  swarmctl log brief marketing          read before drafting: standing rules plus 14 days of feedback
  swarmctl log list marketing --kind feedback,learning --days 30
  swarmctl enqueue --chain --max-cycles 30 --owner app-bot -r you/app --pr polish.md   (see docs/long-running-jobs.md)
  swarmctl log export marketing --days 7 --out marketing-log.md
  sudo swarmctl drain | undrain | restart-when-idle    (on the worker)
"""
import argparse
import base64
import json
import os
import re
import secrets
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

VERSION = "0.3.0"
KIT_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
DRAIN_FILE = os.environ.get("SWARM_DRAIN_FILE", "/var/lib/swarm-runner/drain")
STATE_FILE = os.environ.get("SWARM_STATE_FILE", "/var/lib/swarm-runner/runner-state.json")
LOCAL_PATH = re.compile(r"(?<![\w.~])(/workspace/|/home/|/Users/|/root/|/mnt/|/tmp/|/private/|[A-Za-z]:\\)[^\s'\"`)]*")


def load_env():
    path = os.path.expanduser("~/.config/swarm/client.env")
    if os.path.exists(path):
        for line in open(path):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                os.environ.setdefault(k.strip(), v.strip().strip('"').strip("'"))


def token():
    path = os.path.expanduser(os.environ.get("SWARM_TOKEN_FILE", "~/.config/swarm/client.token"))
    try:
        return open(path).read().strip()
    except OSError:
        sys.exit(f"swarmctl: cannot read token file {path}. Set SWARM_TOKEN_FILE.")


def call(method, path, body=None, raw=False):
    url = os.environ.get("SWARM_URL", "http://127.0.0.1:8750").rstrip("/") + path
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers={
        "Authorization": "Bearer " + token(), "Content-Type": "application/json", "User-Agent": "swarmctl/" + VERSION})
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            out = resp.read()
            return out if raw else json.loads(out)
    except urllib.error.HTTPError as e:
        msg = e.read().decode(errors="replace")
        try:
            msg = json.loads(msg).get("error", msg)
        except ValueError:
            pass
        sys.exit(f"swarmctl: HTTP {e.code}: {msg}")
    except urllib.error.URLError as e:
        sys.exit(f"swarmctl: cannot reach {url}: {e.reason}")


def show(obj):
    print(json.dumps(obj, indent=2, default=str))


def read_prompt(arg):
    return sys.stdin.read() if arg == "-" else open(arg).read()


def local_path_warnings(prompt, attached):
    """Paths on the bot's own computer mean nothing on the worker. Return the ones that were not attached."""
    names = {os.path.basename(a) for a in attached or []}
    out = []
    for m in LOCAL_PATH.finditer(prompt):
        path = m.group(0).rstrip(".,;:")
        if os.path.basename(path) not in names and path not in out:
            out.append(path)
    return out


def cmd_enqueue(a):
    body = {"prompt": read_prompt(a.prompt), "project": a.project, "repo": a.repo, "provider": a.provider,
            "model": a.model, "owner": a.owner, "kind": a.kind, "report_only": a.report_only, "push": a.push,
            "open_pr": a.pr, "pr_number": a.pr_number, "branch": a.branch, "ask_human": a.ask_human,
            "untrusted_input": a.untrusted_input, "command": a.command, "idempotency_key": a.key,
            "title": a.title, "allow_duplicate": a.allow_duplicate, "parent_id": a.parent, "follow_up": a.follow_up,
            "push_main": a.push_main, "timeout_minutes": a.timeout_minutes, "chain": a.chain, "max_cycles": a.max_cycles}
    if a.attach:
        body["attachments"] = [{"name": os.path.basename(p), "content_base64": base64.b64encode(open(p, "rb").read()).decode()}
                               for p in a.attach]
    for path in local_path_warnings(body["prompt"], a.attach)[:5]:
        print(f"WARNING: the brief mentions {path}, a path on your own computer. The worker cannot see it. "
              "Attach the file with --attach instead.", file=sys.stderr)
    r = call("POST", "/tasks", {k: v for k, v in body.items() if v not in (None, False)})
    t = r["task"]
    if r.get("answered_parent"):
        print(f"{t['id']} {t['state']}: task was waiting, so your follow-up was sent as its answer and it resumes")
        return
    note = " (duplicate: this task already exists)" if r.get("duplicate") else ""
    if r.get("held_behind"):
        note += f" (held behind {r['held_behind']}: it runs after that follow-up finishes)"
    print(f"{t['id']} {t['state']} {t['provider']}/{t['model']}{note}")


def cmd_review(a):
    tmpl = open(os.path.join(KIT_DIR, "templates", "review-prompt.md")).read()
    prompt = tmpl.replace("{{REPO}}", a.repo).replace("{{PR}}", str(a.pr_number)) + ("\n\n" + read_prompt(a.extra) if a.extra else "")
    r = call("POST", "/tasks", {k: v for k, v in {"prompt": prompt, "repo": a.repo, "pr_number": a.pr_number, "kind": "review",
                                                  "report_only": True, "provider": a.provider, "model": a.model,
                                                  "owner": a.owner, "project": a.project}.items() if v is not None})
    print(r["task"]["id"], r["task"]["state"], r["task"]["provider"] + "/" + r["task"]["model"])


def cmd_list(a):
    qs = {k: v for k, v in {"state": a.state, "owner": a.owner, "project": a.project, "updated_since": a.since,
                            "limit": a.limit}.items() if v}
    r = call("GET", "/tasks?" + urllib.parse.urlencode(qs))
    if a.json:
        return show(r)
    for t in r["tasks"]:
        title = (t.get("title") or (t["prompt"].strip().splitlines() or [""])[0])[:60]
        held = f" [held behind {t['held_behind']}]" if t.get("held_behind") and t["state"] == "queued" else ""
        if t.get("chain"):
            held += f" [chain {t['chain_root']} cycle {t['cycle']}/{t['max_cycles']}]"
        print(f"{t['id']:30} {t['state']:9} {str(t.get('owner') or '-'):18} {title}{held}")


def cmd_status(a):
    r = call("GET", "/status")
    if a.json:
        return show(r)
    print(f"backend {r['version']}  tasks: " + (", ".join(f"{k} {v}" for k, v in sorted(r["tasks"].items())) or "none"))
    print(f"waiting on you: {r['items_due']}   notices: " + (", ".join(f"{k} {v}" for k, v in sorted(r["notices"].items())) or "none"))
    for w in r.get("workers") or []:
        ago = int(time.time()) - (w["last_seen"] or 0)
        print(f"  worker   {w['name']}  last seen {ago}s ago{'  (draining)' if w['draining'] else ''}")
    for t in r["running"]:
        print(f"  running  {t['id']}  owner {t['owner']}  on {t['lease_worker']}")
    for t in r["waiting"]:
        print(f"  waiting  {t['id']}  on {t['waiting_on']}  {(t['question'] or '')[:80]}")
    for w in r.get("warnings") or []:
        print("  WARNING: " + w)
    if r["stuck_running"]:
        print("  STUCK (no heartbeat): " + ", ".join(r["stuck_running"]))


def cmd_waiting(a):
    if a.action == "list":
        r = call("GET", "/waiting?" + urllib.parse.urlencode({"status": a.status or "due"}))
        if a.json:
            return show(r)
        c = r.get("counts") or {}
        print(f"{c.get('open', 0)} open, {c.get('snoozed', 0)} snoozed, oldest {c.get('oldest_days', 0)} days")
        if c.get("stale"):
            print(f"{c['stale']} open for {c['stale_days']} days or more: answer them, or drop the ones that no longer matter")
        for i in r["items"]:
            print(f"{i['id']:24} {i['project'] or '-':14} {i['bot'] or '-':16} {str(i.get('age_days', 0)) + 'd':5} {(i['ask'] or '')[:70]}")
            if i.get("recommendation"):
                print(f"{'':24} recommend: {i['recommendation'][:90]}")
        return
    if a.action == "add":
        body = {"project": a.project, "bot": a.bot, "kind": a.kind, "ask": a.ask, "recommendation": a.rec,
                "links": a.link or [], "options": a.option or [], "dedupe_key": a.key, "task_id": a.task_id}
        return show(call("POST", "/waiting", body))
    body = {"action": a.action, "answer": a.text, "note": a.text}
    if a.action == "snooze":
        body["until"] = int(time.time() + 86400 * (a.days or 1))
    show(call("POST", f"/waiting/{a.id}", body))


def log_query(a):
    q = {"project": a.project or "", "kind": a.kind or "", "limit": a.limit or "", "ref": a.ref or "", "status": a.status or ""}
    if a.days:
        q["since"] = int(time.time() - 86400 * a.days)
    return urllib.parse.urlencode({k: v for k, v in q.items() if v != ""})


def cmd_log(a):
    if a.action == "add":
        if not a.project:
            sys.exit("swarmctl: log add needs a project: swarmctl log add PROJECT --kind KIND \"SUMMARY\"")
        detail = read_prompt(a.detail) if a.detail else None
        body = {"project": a.project, "kind": a.kind or "activity", "summary": a.summary, "detail": detail,
                "links": a.link or [], "task_id": a.task_id, "dedupe_key": a.key, "by": a.by, "status": a.status, "ref": a.ref,
                "answer": a.answer, "source": a.source, "after": a.after, "learning": a.learning, "proposal": a.proposal,
                "expires_days": a.expires_days, "new_version": a.new_version, "version": a.version}
        return show(call("POST", "/log", {k: v for k, v in body.items() if v not in (None, False)}))
    if a.action in ("items", "rules", "brief"):
        if not a.project:
            sys.exit(f"swarmctl: log {a.action} needs a project")
        q = urllib.parse.urlencode({"project": a.project, "status": a.status or ""})
        if a.action == "brief":
            return sys.stdout.write(call("GET", "/log/brief?" + q, raw=True).decode())
        if a.action == "rules":
            return show(call("GET", "/log/rules?" + q)) if a.json else sys.stdout.write(
                call("GET", "/log/rules?format=md&" + q, raw=True).decode())
        r = call("GET", "/log/items?" + q)
        if a.json:
            return show(r)
        for i in r["items"]:
            print(f"{i['ref']:12} v{i['version']:<3} {i['status']:13} {i['summary'][:80]}")
        return
    if a.action == "list":
        r = call("GET", "/log?" + log_query(a))
        if a.json:
            return show(r)
        for e in r["entries"]:
            when = time.strftime("%Y-%m-%d %H:%M", time.gmtime(e["created_at"]))
            rec = " ".join(str(x) for x in (e.get("ref"), e.get("version") and f"v{e['version']}", e.get("status")) if x)
            print(f"{when}  #{e['id']:<5} {e['project']:14} {e['kind']:9} {(e.get('by') or e['bot'] or '-'):16} "
                  f"{(rec + ': ') if rec else ''}{e['summary'][:90]}")
        return
    # export: one project to a file (or stdout), or every project you can read into a folder
    if a.project:
        text = call("GET", "/log/export?" + log_query(a), raw=True).decode()
        if a.out:
            with open(a.out, "w") as fh:
                fh.write(text)
            return print(a.out)
        return sys.stdout.write(text)
    if not a.dir:
        sys.exit("swarmctl: log export needs a PROJECT, or --dir DIR for every project")
    os.makedirs(a.dir, exist_ok=True)
    for p in call("GET", "/projects")["projects"]:
        a.project = p["name"]
        out = os.path.join(a.dir, f"{p['name']}-log.md")
        with open(out, "w") as fh:
            fh.write(call("GET", "/log/export?" + log_query(a), raw=True).decode())
        with open(os.path.join(a.dir, f"{p['name']}-rules.md"), "w") as fh:
            fh.write(call("GET", "/log/rules?format=md&project=" + urllib.parse.quote(p["name"]), raw=True).decode())
        print(out)
    if a.git:
        git_commit(a.dir, "Project log export " + time.strftime("%Y-%m-%d", time.gmtime()))


def git_commit(folder, message):
    """Commit the export folder to a local git repo so every export shows as a diff (git log -p)."""
    if not os.path.isdir(os.path.join(folder, ".git")):
        subprocess.run(["git", "init", "-q"], cwd=folder, check=True)
    subprocess.run(["git", "add", "-A"], cwd=folder, check=True)
    r = subprocess.run(["git", "-c", "user.name=swarmctl", "-c", "user.email=swarmctl@localhost", "commit", "-q", "-m", message],
                       cwd=folder, capture_output=True, text=True)
    print("committed" if r.returncode == 0 else "nothing new to commit", "in", folder)


def write_secret_file(out, value):
    """Write a secret to a new private file and move it into place. Refuses links. Mode 600 always."""
    out = os.path.abspath(os.path.expanduser(out))
    parent = os.path.dirname(out) or "."
    if os.path.islink(out):
        sys.exit(f"swarmctl: {out} is a symbolic link; refusing to write a token through it")
    if os.path.exists(out) and not os.path.isfile(out):
        sys.exit(f"swarmctl: {out} is not a regular file")
    os.makedirs(parent, mode=0o700, exist_ok=True)
    tmp = os.path.join(parent, f".{os.path.basename(out)}.{secrets.token_hex(4)}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        os.fchmod(fd, 0o600)
        os.write(fd, (value + "\n").encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, out)
    return out


def check_writable(out):
    out = os.path.abspath(os.path.expanduser(out))
    parent = os.path.dirname(out) or "."
    if os.path.islink(out) or (os.path.exists(out) and not os.path.isfile(out)):
        sys.exit(f"swarmctl: {out} must be a regular file, not a link or folder. Nothing was changed.")
    probe = parent
    while not os.path.exists(probe):
        probe = os.path.dirname(probe)
    if not os.access(probe, os.W_OK):
        sys.exit(f"swarmctl: cannot write in {probe}. Nothing was changed; the old token still works.")
    return out


def cmd_bot(a):
    if a.action == "list":
        return show(call("GET", "/bots"))
    if a.action == "token":
        out = check_writable(a.out or f"~/.config/swarm/bot-{a.id}.token")
        r = call("POST", f"/bots/{a.id}/token")
        try:
            out = write_secret_file(out, r["token"])
        except OSError as e:
            sys.exit(f"swarmctl: the new token was made but could not be saved ({e}). The old token no longer works. "
                     "Fix the folder and run the command again to make another one.")
        print(f"token for {a.id} written to {out} (mode 600). Hand the file to the bot through your secrets store, not chat.")
        return
    if a.action == "test":
        return show(call("POST", f"/bots/{a.id}/test", {"nonce": a.nonce} if a.nonce else {}))
    if a.action == "show":
        return show(call("GET", f"/bots/{a.id}"))
    body = {}
    if a.notify_url is not None:
        body["notify_url"] = a.notify_url
    if a.notify_auth_file:
        body["notify_auth"] = open(os.path.expanduser(a.notify_auth_file)).read().strip()
    if a.clear_notify_auth:
        body["notify_auth"] = ""
    if a.role:
        body["role"] = a.role
    show(call("PUT", f"/bots/{a.id}", body))


def cmd_project(a):
    if a.action == "list":
        return show(call("GET", "/projects"))
    if not a.name:
        sys.exit("swarmctl: project set and project show need a project name")
    if a.action == "show":
        for p in call("GET", "/projects")["projects"]:
            if p["name"] == a.name:
                return show(p)
        sys.exit(f"swarmctl: no project {a.name}")
    body = {"default_repo": a.repo, "default_provider": a.provider, "default_model": a.model,
            "add_bots": a.bot, "remove_bots": a.remove_bot, "add_repos": a.extra_repo}
    body = {k: v for k, v in body.items() if v}
    if a.no_push:
        body["allow_push"] = False
    if a.allow_push:
        body["allow_push"] = True
    if a.allow_push_main:
        body["allow_push_main"] = True
    if a.no_push_main:
        body["allow_push_main"] = False
    if a.log_git:
        body["log_git"] = True
    if a.no_log_git:
        body["log_git"] = False
    show(call("PUT", f"/projects/{a.name}", body))


def runner_state():
    try:
        return json.load(open(STATE_FILE))
    except (OSError, ValueError):
        return None


def cmd_drain(a):
    if a.cmd == "undrain":
        try:
            os.remove(DRAIN_FILE)
        except FileNotFoundError:
            pass
        except PermissionError:
            sys.exit("swarmctl: run with sudo on the worker")
        print("worker takes new tasks again")
        return
    try:
        open(DRAIN_FILE, "a").close()
        os.chmod(DRAIN_FILE, 0o644)
    except PermissionError:
        sys.exit("swarmctl: run with sudo on the worker")
    st = runner_state() or {}
    print(f"worker is draining: it finishes running tasks and takes no new ones. Running now: {len(st.get('running') or [])}")
    if a.cmd == "drain":
        return
    start, last_print = time.time(), 0
    while True:
        st = runner_state() or {}
        running = st.get("running") or []
        stale = time.time() - (st.get("updated") or 0) > 180
        if not running or stale:
            break
        if a.max_wait and time.time() - start > a.max_wait:
            sys.exit(f"swarmctl: still running after {a.max_wait} seconds: {', '.join(running)}. "
                     "The worker stays drained; run again later or 'sudo swarmctl undrain'.")
        if time.time() - last_print > 60:
            print(f"waiting for {len(running)} task(s): {', '.join(running)}", flush=True)
            last_print = time.time()
        time.sleep(10)
    for unit in ["swarm-worker"] + (a.also or []):
        print(f"restarting {unit}")
        r = subprocess.run(["systemctl", "restart", unit])
        if r.returncode != 0:
            sys.exit(f"swarmctl: restart of {unit} failed; the worker stays drained. Check: journalctl -u {unit} -n 50")
    try:
        os.remove(DRAIN_FILE)
    except FileNotFoundError:
        pass
    print("done: restarted while idle, and the worker takes new tasks again")


def main():
    load_env()
    argv = sys.argv[1:]
    # Older form "swarmctl project NAME --repo ..." still works and means "project set NAME".
    if len(argv) >= 2 and argv[0] == "project" and argv[1] not in ("set", "list", "show", "-h", "--help"):
        argv = ["project", "set"] + argv[1:]
    p = argparse.ArgumentParser(prog="swarmctl", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version="swarmctl " + VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)

    e = sub.add_parser("enqueue", help="queue a task")
    e.add_argument("prompt", help="brief file, or - for stdin")
    e.add_argument("-p", "--project"); e.add_argument("-r", "--repo"); e.add_argument("-P", "--provider", choices=["claude", "codex"])
    e.add_argument("-m", "--model"); e.add_argument("--owner"); e.add_argument("--kind"); e.add_argument("--title")
    e.add_argument("--report-only", action="store_true"); e.add_argument("--push", action="store_true")
    e.add_argument("--pr", action="store_true", help="push agent/<id> and open a draft PR")
    e.add_argument("--push-main", action="store_true", help="push the default branch (only if the project allows it)")
    e.add_argument("--pr-number", type=int, help="work on top of this existing PR"); e.add_argument("--branch")
    e.add_argument("--ask-human", action="store_true", help="a question from this task goes to the human, not the bot")
    e.add_argument("--untrusted-input", action="store_true", help="brief came from email, tickets or scraped pages")
    e.add_argument("--command", help="script task: run this shell command with no model")
    e.add_argument("--attach", action="append"); e.add_argument("--key", help="idempotency key: same key returns the same task")
    e.add_argument("--allow-duplicate", action="store_true")
    e.add_argument("--follow-up", metavar="TASK_ID", help="continue earlier work: same repo, branch, flags and folder")
    e.add_argument("--parent", help="link to a related task (just a label; use --follow-up to continue work)")
    e.add_argument("--timeout-minutes", type=float, help="this task's time limit (up to the admin maximum, SWARM_TASK_TIMEOUT_MAX)")
    e.add_argument("--chain", action="store_true", help="run in short cycles; each cycle queues the next with its checkpoint")
    e.add_argument("--max-cycles", type=int, help="chain: stop after this many cycles (default 20)")
    e.set_defaults(fn=cmd_enqueue)

    r = sub.add_parser("review", help="queue a second-model review of a PR (report only)")
    r.add_argument("-r", "--repo", required=True); r.add_argument("--pr-number", type=int, required=True)
    r.add_argument("-P", "--provider", choices=["claude", "codex"]); r.add_argument("-m", "--model")
    r.add_argument("--owner"); r.add_argument("-p", "--project"); r.add_argument("--extra", help="file with extra context")
    r.set_defaults(fn=cmd_review)

    ls = sub.add_parser("list", help="list tasks")
    for f in ("--state", "--owner", "--project", "--since", "--limit"):
        ls.add_argument(f)
    ls.add_argument("--json", action="store_true"); ls.set_defaults(fn=cmd_list)

    st = sub.add_parser("status", help="one-screen summary"); st.add_argument("--json", action="store_true"); st.set_defaults(fn=cmd_status)

    for name, method, path in (("show", "GET", "/tasks/{}"), ("report", "GET", "/tasks/{}/report"),
                               ("artifacts", "GET", "/tasks/{}/artifacts"), ("cancel", "POST", "/tasks/{}/cancel")):
        s = sub.add_parser(name); s.add_argument("id")
        s.set_defaults(fn=lambda a, m=method, pth=path, n=name: (
            sys.stdout.write(call(m, pth.format(a.id), {} if m == "POST" else None, raw=True).decode()) if n == "report"
            else show(call(m, pth.format(a.id), {} if m == "POST" else None))))

    g = sub.add_parser("get-artifact"); g.add_argument("id"); g.add_argument("name"); g.add_argument("-o", "--out", required=True)
    g.set_defaults(fn=lambda a: open(a.out, "wb").write(call("GET", f"/tasks/{a.id}/artifacts/{urllib.parse.quote(a.name)}", raw=True)))

    for name, field in (("answer", "answer"), ("message", "text")):
        s = sub.add_parser(name); s.add_argument("id"); s.add_argument("text")
        s.set_defaults(fn=lambda a, n=name, f=field: show(call("POST", f"/tasks/{a.id}/{n}", {f: a.text})))

    w = sub.add_parser("waiting", help="the Waiting on you list")
    w.add_argument("action", choices=["list", "add", "answer", "snooze", "drop", "done", "withdraw"])
    w.add_argument("id", nargs="?"); w.add_argument("text", nargs="?")
    w.add_argument("--status"); w.add_argument("--project"); w.add_argument("--bot")
    w.add_argument("--kind", choices=["decision", "deliverable-review"], default="decision")
    w.add_argument("--ask"); w.add_argument("--rec"); w.add_argument("--link", action="append"); w.add_argument("--option", action="append")
    w.add_argument("--key"); w.add_argument("--task-id"); w.add_argument("--days", type=int); w.add_argument("--json", action="store_true")
    w.set_defaults(fn=cmd_waiting)

    b = sub.add_parser("bot", help="bot settings")
    b.add_argument("action", choices=["list", "show", "set", "token", "test"]); b.add_argument("id", nargs="?")
    b.add_argument("--notify-url"); b.add_argument("--notify-auth-file", help="file holding the bot's trigger key")
    b.add_argument("--clear-notify-auth", action="store_true"); b.add_argument("--role", choices=["chief", "project"])
    b.add_argument("--out"); b.add_argument("--nonce", help="bot test: reuse a nonce to check that a repeat is not sent twice")
    b.set_defaults(fn=cmd_bot)

    pj = sub.add_parser("project", help="project settings: swarmctl project set NAME --repo OWNER/REPO --bot BOT_ID")
    pj.add_argument("action", choices=["set", "list", "show"]); pj.add_argument("name", nargs="?")
    pj.add_argument("--repo", help="main repo, OWNER/NAME"); pj.add_argument("--extra-repo", action="append", help="another repo this project may use")
    pj.add_argument("--bot", action="append", help="bind a project bot to this project (repeat for more)")
    pj.add_argument("--remove-bot", action="append"); pj.add_argument("--provider", choices=["claude", "codex"]); pj.add_argument("--model")
    pj.add_argument("--no-push", action="store_true"); pj.add_argument("--allow-push", action="store_true")
    pj.add_argument("--allow-push-main", action="store_true", help="let tasks use --push-main (off by default)")
    pj.add_argument("--log-git", action="store_true", help="commit this project's weekly log export to a local git repo")
    pj.add_argument("--no-log-git", action="store_true")
    pj.add_argument("--no-push-main", action="store_true")
    pj.set_defaults(fn=cmd_project)

    lg = sub.add_parser("log", help="the project log: add, list, export (a history for every project, repo or not)")
    lg.add_argument("action", choices=["add", "list", "export", "items", "rules", "brief"]); lg.add_argument("project", nargs="?")
    lg.add_argument("summary", nargs="?", help="log add: one line saying what happened")
    lg.add_argument("--kind", help="activity, decision, result, item, feedback, learning or rule (list: comma list to filter)")
    lg.add_argument("--by", help="who decided, gave feedback or gave a verdict (required for those)")
    lg.add_argument("--status", help="item: draft, needs-review, approved, changes, rejected. rule: proposed, approved, rejected")
    lg.add_argument("--ref", help="the record this is about, for example item-12 or rule-30")
    lg.add_argument("--answer", help="decision: what was decided"); lg.add_argument("--source", help="where it came from, for example chat")
    lg.add_argument("--after", help="rule change: the new rule text (leave out with --ref to remove a rule)")
    lg.add_argument("--learning", help="rule change: the learning it comes from, for example learning-14")
    lg.add_argument("--proposal", type=int, help="rule review: the id of the proposed change")
    lg.add_argument("--expires-days", type=float, help="new item: a throwaway item that disappears after this many days")
    lg.add_argument("--new-version", action="store_true", help="item: this is a new version (older verdicts stop counting)")
    lg.add_argument("--version", type=int, help="item verdict: the version you reviewed (refused if it is out of date)")
    lg.add_argument("--git", action="store_true", help="export --dir: commit the folder to a local git repo to keep diffs")
    lg.add_argument("--detail", help="log add: file with more detail, or - for stdin")
    lg.add_argument("--link", action="append"); lg.add_argument("--task-id"); lg.add_argument("--key", help="log add: same key is kept once")
    lg.add_argument("--days", type=float, help="only the last N days"); lg.add_argument("--limit")
    lg.add_argument("--out", help="export: write to this file"); lg.add_argument("--dir", help="export: one file per project in this folder")
    lg.add_argument("--json", action="store_true"); lg.set_defaults(fn=cmd_log)

    nt = sub.add_parser("notices", help="recent deliveries to bot inboxes (admin or chief)")
    nt.set_defaults(fn=lambda a: show(call("GET", "/notices")))

    al = sub.add_parser("alert", help="send an alert to the Chief of Staff (worker scripts use this)")
    al.add_argument("key"); al.add_argument("text")
    al.set_defaults(fn=lambda a: show(call("POST", "/alerts", {"key": a.key, "text": a.text})))

    for name, hlp in (("drain", "worker: stop taking new tasks (run with sudo on the worker)"),
                      ("undrain", "worker: take new tasks again"),
                      ("restart-when-idle", "worker: drain, wait until no task runs, restart, undrain")):
        d = sub.add_parser(name, help=hlp)
        d.add_argument("--max-wait", type=int, help="give up after this many seconds (default: wait as long as it takes)")
        d.add_argument("--also", action="append", help="also restart this systemd unit while idle, for example a proxy")
        d.set_defaults(fn=cmd_drain)

    a, extra = p.parse_known_args(argv)
    # "log add PROJECT --kind KIND SUMMARY": argparse leaves a summary written after the options unparsed.
    if extra and a.cmd == "log" and a.summary is None and len(extra) == 1 and not extra[0].startswith("-"):
        a.summary, extra = extra[0], []
    if extra:
        p.error("unrecognized arguments: " + " ".join(extra))
    if getattr(a, "action", None) not in (None, "list", "add") and a.cmd in ("waiting",) and not a.id:
        sys.exit("swarmctl: this action needs an item id")
    if a.cmd == "bot" and a.action != "list" and not a.id:
        sys.exit("swarmctl: this action needs a bot id")
    a.fn(a)


if __name__ == "__main__":
    main()
