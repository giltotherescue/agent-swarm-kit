VERSION = "0.8.1"
KIT_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
DRAIN_FILE = os.environ.get("SWARM_DRAIN_FILE", "/var/lib/swarm-runner/drain")
STATE_FILE = os.environ.get("SWARM_STATE_FILE", "/var/lib/swarm-runner/runner-state.json")
LOCAL_PATH = re.compile(r"(?<![\w.~])(/workspace/|/home/|/Users/|/root/|/mnt/|/tmp/|/private/|[A-Za-z]:\\)[^\s'\"`)]*")


def load_env():
    path = os.path.expanduser("~/.config/swarm/client.env")
    if os.path.exists(path):
        for line in open(path):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                os.environ.setdefault(k.strip(), v.strip().strip('"').strip("'"))


def token():
    path = os.path.expanduser(os.environ.get("SWARM_TOKEN_FILE", "~/.config/swarm/client.token"))
    try:
        return open(path).read().strip()
    except OSError:
        sys.exit(f"swarmctl: cannot read token file {path}. Set SWARM_TOKEN_FILE.")


def call(method, path, body=None, raw=False):
    url = os.environ.get("SWARM_URL", "http://127.0.0.1:8750").rstrip("/") + path
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers={
        "Authorization": "Bearer " + token(), "Content-Type": "application/json", "User-Agent": "swarmctl/" + VERSION})
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            out = resp.read()
            return out if raw else json.loads(out)
    except urllib.error.HTTPError as e:
        msg = e.read().decode(errors="replace")
        try:
            msg = json.loads(msg).get("error", msg)
        except ValueError:
            pass
        sys.exit(f"swarmctl: HTTP {e.code}: {msg}")
    except urllib.error.URLError as e:
        sys.exit(f"swarmctl: cannot reach {url}: {e.reason}")


def show(obj):
    print(json.dumps(obj, indent=2, default=str))


def read_prompt(arg):
    return sys.stdin.read() if arg == "-" else open(arg).read()


def local_path_warnings(prompt, attached):
    """Paths on the bot's own computer mean nothing on the worker. Return the ones that were not attached."""
    names = {os.path.basename(a) for a in attached or []}
    out = []
    for m in LOCAL_PATH.finditer(prompt):
        path = m.group(0).rstrip(".,;:")
        if os.path.basename(path) not in names and path not in out:
            out.append(path)
    return out


def need_owner(a):
    """Fail fast without an owner: --owner wins, else ENQUEUE_OWNER. A follow-up inherits its parent's owner."""
    a.owner = (a.owner or "").strip() or os.environ.get("ENQUEUE_OWNER", "").strip() or None
    if not a.owner and not getattr(a, "follow_up", None):
        sys.exit("error: no owner. Pass --owner <bot id or alias>, or set ENQUEUE_OWNER.")


def cmd_enqueue(a):
    need_owner(a)
    body = {"prompt": read_prompt(a.prompt), "project": a.project, "repo": a.repo, "provider": a.provider,
            "model": a.model, "owner": a.owner, "kind": a.kind, "report_only": a.report_only, "push": a.push,
            "open_pr": a.pr, "pr_number": a.pr_number, "branch": a.branch, "ask_human": a.ask_human,
            "untrusted_input": a.untrusted_input, "command": a.command, "idempotency_key": a.key,
            "title": a.title, "allow_duplicate": a.allow_duplicate, "parent_id": a.parent, "follow_up": a.follow_up,
            "target_worker": a.worker, "base": a.base,
            "push_main": a.push_main, "allow_gitlink": a.allow_gitlink, "timeout_minutes": a.timeout_minutes, "chain": a.chain, "max_cycles": a.max_cycles}
    if a.attach:
        body["attachments"] = [{"name": os.path.basename(p), "content_base64": base64.b64encode(open(p, "rb").read()).decode()}
                               for p in a.attach]
    for path in local_path_warnings(body["prompt"], a.attach)[:5]:
        print(f"WARNING: the brief mentions {path}, a path on your own computer. The worker cannot see it. "
              "Attach the file with --attach instead.", file=sys.stderr)
    r = call("POST", "/tasks", {k: v for k, v in body.items() if v is not None and v is not False})
    t = r["task"]
    if r.get("answered_parent"):
        print(f"{t['id']} {t['state']}: task was waiting, so your follow-up was sent as its answer and it resumes")
        return
    note = " (duplicate: this task already exists)" if r.get("duplicate") else ""
    if r.get("held_behind"):
        note += f" (held behind {r['held_behind']}: it runs after that follow-up finishes)"
    print(f"{t['id']} {t['state']} {t['provider']}/{t['model']}{note}")


def cmd_review(a):
    need_owner(a)
    tmpl = open(os.path.join(KIT_DIR, "templates", "review-prompt.md")).read()
    prompt = tmpl.replace("{{REPO}}", a.repo).replace("{{PR}}", str(a.pr_number)) + ("\n\n" + read_prompt(a.extra) if a.extra else "")
    r = call("POST", "/tasks", {k: v for k, v in {"prompt": prompt, "repo": a.repo, "pr_number": a.pr_number, "kind": "review",
                                                  "report_only": True, "provider": a.provider, "model": a.model,
                                                  "owner": a.owner, "project": a.project}.items() if v is not None})
    print(r["task"]["id"], r["task"]["state"], r["task"]["provider"] + "/" + r["task"]["model"])


def cmd_list(a):
    qs = {k: v for k, v in {"state": a.state, "owner": a.owner, "project": a.project, "updated_since": a.since,
                            "limit": a.limit}.items() if v}
    r = call("GET", "/tasks?" + urllib.parse.urlencode(qs))
    if a.json:
        return show(r)
    for t in r["tasks"]:
        title = (t.get("title") or (t["prompt"].strip().splitlines() or [""])[0])[:60]
        held = f" [held behind {t['held_behind']}]" if t.get("held_behind") and t["state"] == "queued" else ""
        if t.get("chain"):
            held += f" [chain {t['chain_root']} cycle {t['cycle']}/{t['max_cycles']}]"
        print(f"{t['id']:30} {t['state']:9} {str(t.get('owner') or '-'):18} {title}{held}")


def cmd_status(a):
    r = call("GET", "/status")
    if a.json:
        return show(r)
    print(f"backend {r['version']}  tasks: " + (", ".join(f"{k} {v}" for k, v in sorted(r["tasks"].items())) or "none"))
    print(f"waiting on you: {r['items_due']}   notices: " + (", ".join(f"{k} {v}" for k, v in sorted(r["notices"].items())) or "none"))
    for w in r.get("workers") or []:
        ago = int(time.time()) - (w["last_seen"] or 0)
        print(f"  worker   {w['name']}  last seen {ago}s ago{'  (draining)' if w['draining'] else ''}")
    for o in r.get("orchestrators") or []:
        print(f"  orchestrator {o['name']}  {o['state']} (wants {o['desired']})  on {o['worker_id']}  {ago_text(o['last_heartbeat_at'])}")
    for t in r["running"]:
        print(f"  running  {t['id']}  owner {t['owner']}  on {t['lease_worker']}")
    for t in r["waiting"]:
        print(f"  waiting  {t['id']}  on {t['waiting_on']}  {(t['question'] or '')[:80]}")
    for w in r.get("warnings") or []:
        print("  WARNING: " + w)
    if r["stuck_running"]:
        print("  STUCK (no heartbeat): " + ", ".join(r["stuck_running"]))


def ago_text(ts):
    if not ts:
        return "never reported"
    sec = int(time.time()) - ts
    return f"last heartbeat {sec}s ago" if sec < 120 else f"last heartbeat {sec // 60} min ago"


def duration(sec):
    if sec is None:
        return "-"
    d, rest = divmod(int(sec), 86400)
    return (f"{d}d " if d else "") + f"{rest // 3600}h {rest % 3600 // 60}m"


def cmd_orchestrator(a):
    """Long-running orchestrators (docs/orchestrators.md). Creating, changing, starting and stopping need the admin token."""
    path = f"/orchestrators/{urllib.parse.quote(a.name or '', safe='')}"
    if a.action == "list":
        r = call("GET", "/orchestrators")
        if a.json:
            return show(r)
        for o in r["orchestrators"]:
            print(f"{o['name']:20} {o['state']:11} wants {o['desired']:8} on {o['worker_id']:16} up {duration(o['uptime']):10} "
                  f"restarts {o['restart_count']}  {ago_text(o['last_heartbeat_at'])}")
        return
    if not a.name:
        sys.exit(f"swarmctl: orchestrator {a.action} needs a NAME")
    if a.action in ("create", "set"):
        body = {"worker_id": a.worker, "project": a.project, "repo": a.repo, "owner_bot_id": a.owner, "model": a.model,
                "relay_agent_name": a.relay_name}
        if a.brief:
            body["brief"] = read_prompt(a.brief)
        if a.secret_bundle is not None:
            body["secret_bundles"] = [b for b in a.secret_bundle if b]
        if a.no_secret_bundles:
            body["secret_bundles"] = []
        body = {k: v for k, v in body.items() if v is not None}
        if a.action == "create":
            body.update(name=a.name, start=a.start)
            r = call("POST", "/orchestrators", body)
        else:
            r = call("PUT", path, body)
        o = r["orchestrator"]
        print(f"{o['name']} {o['state']} (wants {o['desired']}) on worker {o['worker_id']}")
        if a.action == "create":
            print(f"On worker {o['worker_id']}, install its supervisor once: sudo systemctl enable --now swarm-orchestrator@{o['name']}"
                  " (docs/orchestrators.md; on a Mac: bash scripts/setup-macos.sh --orchestrator NAME)")
        return
    if a.action in ("start", "stop", "restart", "delete"):
        r = call("POST", f"{path}/{a.action}", {})
        verb = {"start": "set to run", "stop": "stopping (the agent gets a wrap-up message first)",
                "restart": "restarting (a crash loop is cleared)", "delete": "deleted"}[a.action]
        print(f"{a.name}: {verb}. The supervisor acts within about 30 seconds.")
        return
    if a.action == "message":
        text = a.text if a.text != "-" else sys.stdin.read()
        r = call("POST", f"{path}/messages", {"text": text})
        print(f"message {r['id']} queued; it is typed into the session when the agent is idle")
        return
    if a.action == "release":
        if not (a.text or "").isdigit():
            sys.exit("swarmctl: orchestrator release needs NAME and the message ID from the delivery-unknown event")
        call("POST", f"{path}/messages/{a.text}/release", {"resend": bool(a.resend)})
        print(f"message {a.text}: " + ("released; the supervisor types it once more" if a.resend else
                                       "marked delivered; the supervisor drops its hold and types nothing"))
        return
    if a.action == "logs":
        r = call("GET", f"{path}/logs?lines={a.lines}")
        if a.json:
            return show(r)
        when = time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(r["at"])) if r["at"] else "never"
        print(f"# last {len(r['lines'])} lines of orch-{a.name}, uploaded {when}")
        print("\n".join(r["lines"]))
        return
    r = call("GET", path)
    if a.json:
        return show(r)
    o = r["orchestrator"]
    print(f"{o['name']}: {o['state']} (wants {o['desired']})")
    for label, value in (("worker", o["worker_id"]), ("project", o["project"]), ("repo", o["repo"] or "-"),
                         ("owner bot", o["owner_bot_id"] or "-"), ("model", o["model"]), ("relay name", o["relay_agent_name"] or "-"),
                         ("secret bundles", ", ".join(o["secret_bundles"]) or "-"), ("tmux session", o["tmux_session"]),
                         ("pid", o["pid"] or "-"), ("session id", o["session_id"] or "-"), ("uptime", duration(o["uptime"])),
                         ("heartbeat", ago_text(o["last_heartbeat_at"])), ("restarts", o["restart_count"]),
                         ("last exit", o["last_exit"] or "-")):
        print(f"  {label:15} {value}")
    if r.get("pending_message"):
        print(f"  {'message':15} one waiting from {r['pending_message']['sender']}")
    print("  last events:")
    for e in r["events"][:10]:
        print(f"    {time.strftime('%m-%d %H:%M', time.gmtime(e['at']))}  {e['type']:18} {e['text'] or ''}")


def cmd_waiting(a):
    if a.action == "list":
        r = call("GET", "/waiting?" + urllib.parse.urlencode({"status": a.status or "due"}))
        if a.json:
            return show(r)
        c = r.get("counts") or {}
        print(f"{c.get('open', 0)} open, {c.get('snoozed', 0)} snoozed, oldest {c.get('oldest_days', 0)} days")
        if c.get("stale"):
            print(f"{c['stale']} open for {c['stale_days']} days or more: answer them, or drop the ones that no longer matter")
        for i in r["items"]:
            print(f"{i['id']:24} {i['project'] or '-':14} {i['bot'] or '-':16} {str(i.get('age_days', 0)) + 'd':5} {(i['ask'] or '')[:70]}")
            if i.get("recommendation"):
                print(f"{'':24} recommend: {i['recommendation'][:90]}")
        return
    if a.action == "add":
        body = {"project": a.project, "bot": a.bot, "kind": a.kind, "ask": a.ask, "recommendation": a.rec,
                "links": a.link or [], "options": a.option or [], "dedupe_key": a.key, "task_id": a.task_id}
        return show(call("POST", "/waiting", body))
    body = {"action": a.action, "answer": a.text, "note": a.text}
    if a.action == "snooze":
        body["until"] = int(time.time() + 86400 * (a.days or 1))
    show(call("POST", f"/waiting/{a.id}", body))


def cmd_review_queue(a):
    """The review queue (docs/review-queue.md)."""
    if a.action == "file":
        body = {"project": a.project, "key": a.key, "type": a.type, "title": a.title, "ask": a.ask, "recommendation": a.rec,
                "options": a.option or [], "links": a.link or []}
        if a.bot:
            body["bot"] = a.bot
        if a.body_file:
            body["body"] = open(a.body_file).read() if a.body_file != "-" else sys.stdin.read()
        return show(call("PUT", "/review/items", {k: v for k, v in body.items() if v is not None}))
    if a.action == "list":
        q = {k: v for k, v in (("status", a.status), ("project", a.project), ("bot", a.bot), ("key", a.key)) if v}
        if a.unacked:
            q["acked"] = "0"
        r = call("GET", "/review/items?" + urllib.parse.urlencode(q))
        if a.json:
            return show(r)
        for i in r["items"]:
            d = i.get("decision") or {}
            print(f"{i['id']:18} {i['status']:17} {i['project'][:14]:14} {i['bot'][:16]:16} r{i['revision']:<3} {(i['title'] or '')[:60]}"
                  + (f"  [{d.get('action')}{', acked' if (i.get('delivery') or {}).get('acked_at') else ''}]" if d else ""))
        print(f"{len(r['items'])} of {r['total']}")
        return
    if not a.id:
        sys.exit("swarmctl: this action needs an item id")
    path = "/review/items/" + urllib.parse.quote(a.id, safe="")
    if a.action == "show":
        return show(call("GET", path))
    if a.action == "decide":
        if not a.decision or not a.hash:
            sys.exit("swarmctl: decide needs --action approve|changes|reject and --hash (the content_hash `show` printed)")
        body = {"action": a.decision, "content_hash": a.hash, "note": a.note, "option": a.choose}
        if a.edited_file:
            body["edited_text"] = open(a.edited_file).read()
        return show(call("POST", path + "/decision", {k: v for k, v in body.items() if v is not None}))
    if a.action == "ack":
        return show(call("POST", path + "/ack", {"revision": a.revision} if a.revision else {}))
    show(call("POST", path + "/close", {"reason": a.note} if a.note else {}))


def log_query(a):
    q = {"project": a.project or "", "kind": a.kind or "", "limit": a.limit or "", "ref": a.ref or "", "status": a.status or ""}
    if a.days:
        q["since"] = int(time.time() - 86400 * a.days)
    return urllib.parse.urlencode({k: v for k, v in q.items() if v != ""})


ACTIVITY_PATH = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:-]{0,80}/(?:decisions\.md|log/[0-9]{4}-[0-9]{2}\.md)")
ACTIVITY_BEGIN = b"<!-- activity-log:begin -->"
ACTIVITY_END = b"<!-- activity-log:end -->"


def merge_activity_decisions(current, generated):
    def markers(text, marker):
        return list(re.finditer(rb"(?m)^" + re.escape(marker) + rb"(?=\r?$)", text))

    new_start, new_end = markers(generated, ACTIVITY_BEGIN), markers(generated, ACTIVITY_END)
    if (len(new_start) != 1 or len(new_end) != 1 or new_start[0].start() != 0 or
            not generated.endswith(ACTIVITY_END + b"\n")):
        raise ValueError("invalid generated decisions block")
    starts, ends = markers(current, ACTIVITY_BEGIN), markers(current, ACTIVITY_END)
    if not starts and not ends:
        return current + (b"\n\n" if current and not current.endswith(b"\n\n") else b"") + generated
    if len(starts) != 1 or len(ends) != 1 or starts[0].start() >= ends[0].start():
        raise ValueError("decisions file must have one ordered pair of activity markers")
    prior = {line for line in current[starts[0].start():ends[0].end()].splitlines() if line.startswith(b"- ")}
    if not prior.issubset(generated.splitlines()):
        raise ValueError("generated decisions are append-only; use a fresh snapshot")
    return current[:starts[0].start()] + generated[:-1] + current[ends[0].end():]


def activity_path(root, relative):
    if not ACTIVITY_PATH.fullmatch(relative):
        raise ValueError("invalid activity export path")
    path = root / relative
    if any(part.is_symlink() for part in (path, *path.parents) if root in part.parents):
        raise ValueError("refusing an export path with symlinks")
    return path


def write_activity_file(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=path.parent) as tmp:
        staged = Path(tmp) / path.name
        staged.write_bytes(data)
        staged.replace(path)


def apply_activity(a):
    root = Path(a.dir).expanduser().resolve()
    if not root.is_dir():
        sys.exit("swarmctl: --dir must name an existing folder")
    try:
        payload = json.loads(read_prompt(a.snapshot))
        snapshots = payload if isinstance(payload, list) else [payload]
        changes, seen = {}, set()
        for snapshot in snapshots:
            if not isinstance(snapshot, dict) or not isinstance(snapshot.get("files"), dict):
                raise ValueError("expected an activity snapshot or a list of snapshots")
            for relative, text in snapshot["files"].items():
                path = activity_path(root, relative)
                if path in seen or not isinstance(text, str):
                    raise ValueError("each snapshot file must appear once and contain text")
                seen.add(path)
                current = path.read_bytes() if path.exists() else b""
                data = text.encode()
                if path.name == "decisions.md":
                    data = merge_activity_decisions(current, data)
                elif current.startswith(data):
                    continue  # already has this snapshot (or a newer one)
                elif not data.startswith(current):
                    raise ValueError("monthly activity files are append-only; use a fresh snapshot")
                if current != data:
                    changes[path] = data
        for path, data in changes.items():
            write_activity_file(path, data)
            print(path.relative_to(root))
    except (OSError, ValueError) as exc:
        sys.exit(f"swarmctl: could not apply snapshot: {exc}")


def cmd_activity(a):
    if a.action == "add":
        body = dict(project=a.project, kind=a.kind, decider=a.decider, summary=a.summary, link=a.link,
                    dedupe_key=a.key, overrules=a.overrules, lasting=a.lasting)
        return show(call("POST", "/activity-log", body))
    if a.action == "list":
        query = {k: v for k, v in dict(project=a.project, limit=a.limit, kind=a.kind, decider=a.decider).items() if v is not None}
        result = call("GET", "/activity-log?" + urllib.parse.urlencode(query))
        if a.json:
            return show(result)
        for entry in result["entries"]:
            print(entry["line"])
        return
    if a.action == "published":
        return show(call("POST", "/activity-log/published", dict(project=a.project, through=a.through)))
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.:-]{0,80}", a.project):
        sys.exit("swarmctl: project must be a registered project name")
    if a.nightly:
        query = urllib.parse.urlencode({k: v for k, v in dict(project=a.project, after=a.after).items() if v is not None})
        result = call("GET", "/activity-log/snapshot?" + query)
        if result["files"]:
            show(result)
        return
    if a.after is not None:
        sys.exit("swarmctl: --after needs --nightly")
    month = a.month or datetime.now(ZoneInfo("America/Chicago")).strftime("%Y-%m")
    if not re.fullmatch(r"[0-9]{4}-[0-9]{2}", month):
        sys.exit("swarmctl: month must be YYYY-MM")
    query = urllib.parse.urlencode(dict(project=a.project, month=month))
    sys.stdout.buffer.write(call("GET", "/activity-log/export?" + query, raw=True))


def cmd_log(a):
    if a.action == "add":
        if not a.project:
            sys.exit("swarmctl: log add needs a project: swarmctl log add PROJECT --kind KIND \"SUMMARY\"")
        detail = read_prompt(a.detail) if a.detail else None
        body = {"project": a.project, "kind": a.kind or "activity", "summary": a.summary, "detail": detail,
                "links": a.link or [], "task_id": a.task_id, "dedupe_key": a.key, "by": a.by, "status": a.status, "ref": a.ref,
                "answer": a.answer, "source": a.source, "after": a.after, "learning": a.learning, "proposal": a.proposal,
                "expires_days": a.expires_days, "new_version": a.new_version, "version": a.version}
        return show(call("POST", "/log", {k: v for k, v in body.items() if v is not None and v is not False}))
    if a.action in ("items", "rules", "brief"):
        if not a.project:
            sys.exit(f"swarmctl: log {a.action} needs a project")
        q = urllib.parse.urlencode({"project": a.project, "status": a.status or ""})
        if a.action == "brief":
            return sys.stdout.write(call("GET", "/log/brief?" + q, raw=True).decode())
        if a.action == "rules":
            return show(call("GET", "/log/rules?" + q)) if a.json else sys.stdout.write(
                call("GET", "/log/rules?format=md&" + q, raw=True).decode())
        r = call("GET", "/log/items?" + q)
        if a.json:
            return show(r)
        for i in r["items"]:
            print(f"{i['ref']:12} v{i['version']:<3} {i['status']:13} {i['summary'][:80]}")
        return
    if a.action == "list":
        r = call("GET", "/log?" + log_query(a))
        if a.json:
            return show(r)
        for e in r["entries"]:
            when = time.strftime("%Y-%m-%d %H:%M", time.gmtime(e["created_at"]))
            rec = " ".join(str(x) for x in (e.get("ref"), e.get("version") and f"v{e['version']}", e.get("status")) if x)
            print(f"{when}  #{e['id']:<5} {e['project']:14} {e['kind']:9} {(e.get('by') or e['bot'] or '-'):16} "
                  f"{(rec + ': ') if rec else ''}{e['summary'][:90]}")
        return
    # export: one project to a file (or stdout), or every project you can read into a folder
    if a.project:
        text = call("GET", "/log/export?" + log_query(a), raw=True).decode()
        if a.out:
            with open(a.out, "w") as fh:
                fh.write(text)
            return print(a.out)
        return sys.stdout.write(text)
    if not a.dir:
        sys.exit("swarmctl: log export needs a PROJECT, or --dir DIR for every project")
    os.makedirs(a.dir, exist_ok=True)
    for p in call("GET", "/projects")["projects"]:
        a.project = p["name"]
        out = os.path.join(a.dir, f"{p['name']}-log.md")
        with open(out, "w") as fh:
            fh.write(call("GET", "/log/export?" + log_query(a), raw=True).decode())
        with open(os.path.join(a.dir, f"{p['name']}-rules.md"), "w") as fh:
            fh.write(call("GET", "/log/rules?format=md&project=" + urllib.parse.quote(p["name"]), raw=True).decode())
        print(out)
    if a.git:
        git_commit(a.dir, "Project log export " + time.strftime("%Y-%m-%d", time.gmtime()))


def git_commit(folder, message):
    """Commit the export folder to a local git repo so every export shows as a diff (git log -p).

    Uses the backend export's guarded commit (server/swarm_gitlink.py): a copy of the index, submodule pins never
    staged (opt-in disabled), git output captured, every diagnostic redacted before it is printed. Exits 1 on failure."""
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import swarm_gitlink
    try:
        made = swarm_gitlink.commit_leftover(folder, message, allow_gitlink=False,
                                             identity=("swarmctl", "swarmctl@localhost"),
                                             log=lambda m: print("swarmctl: log export:", m, file=sys.stderr, flush=True))
    except (OSError, RuntimeError, subprocess.SubprocessError) as e:
        sys.exit("swarmctl: log export: git commit failed: " + swarm_gitlink.bounded_diagnostic(str(e), 1000))
    print("committed" if made else "nothing new to commit", "in", folder)


def write_secret_file(out, value):
    """Write a secret to a new private file and move it into place. Refuses links. Mode 600 always."""
    out = os.path.abspath(os.path.expanduser(out))
    parent = os.path.dirname(out) or "."
    if os.path.islink(out):
        sys.exit(f"swarmctl: {out} is a symbolic link; refusing to write a token through it")
    if os.path.exists(out) and not os.path.isfile(out):
        sys.exit(f"swarmctl: {out} is not a regular file")
    os.makedirs(parent, mode=0o700, exist_ok=True)
    tmp = os.path.join(parent, f".{os.path.basename(out)}.{secrets.token_hex(4)}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        os.fchmod(fd, 0o600)
        os.write(fd, (value + "\n").encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, out)
    return out


def check_writable(out):
    out = os.path.abspath(os.path.expanduser(out))
    parent = os.path.dirname(out) or "."
    if os.path.islink(out) or (os.path.exists(out) and not os.path.isfile(out)):
        sys.exit(f"swarmctl: {out} must be a regular file, not a link or folder. Nothing was changed.")
    probe = parent
    while not os.path.exists(probe):
        probe = os.path.dirname(probe)
    if not os.access(probe, os.W_OK):
        sys.exit(f"swarmctl: cannot write in {probe}. Nothing was changed; the old token still works.")
    return out


def cmd_bot(a):
    if a.action == "list":
        return show(call("GET", "/bots"))
    if a.action == "token":
        out = check_writable(a.out or f"~/.config/swarm/bot-{a.id}.token")
        r = call("POST", f"/bots/{a.id}/token")
        try:
            out = write_secret_file(out, r["token"])
        except OSError as e:
            sys.exit(f"swarmctl: the new token was made but could not be saved ({e}). The old token no longer works. "
                     "Fix the folder and run the command again to make another one.")
        print(f"token for {a.id} written to {out} (mode 600). Hand the file to the bot through your secrets store, not chat.")
        return
    if a.action == "test":
        return show(call("POST", f"/bots/{a.id}/test", {"nonce": a.nonce} if a.nonce else {}))
    if a.action == "show":
