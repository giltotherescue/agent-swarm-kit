    s.add_argument("-f", "--file"); s.add_argument("--thread"); s.add_argument("--urgent", action="store_true")
    s.add_argument("--noop", action="store_true", help="store only, never wake the recipient")
    s.add_argument("--blocker", action="store_true")
    s.add_argument("--fyi", action="store_true", help="informational: hold webhook messages for the next digest or wake")
    s.add_argument("--reply", action="store_true", help="a reply is expected"); s.add_argument("--no-reply", dest="no_reply", action="store_true")
    s.add_argument("--id", help="client message id (default: random, reused on retries)"); s.add_argument("--json", action="store_true")
    s = bs.add_parser("inbox", help="unread messages to me"); s.add_argument("--all", action="store_true")
    s.add_argument("--after", type=int); s.add_argument("--json", action="store_true")
    s = bs.add_parser("ack", help="acknowledge a message once its action is recorded"); s.add_argument("id", type=int)
    s = bs.add_parser("status", help="state and delivery attempts"); s.add_argument("id", type=int)
    s = bs.add_parser("thread", help="show a thread"); s.add_argument("thread"); s.add_argument("--json", action="store_true")
    bs.add_parser("agents", help="registered agents and reachability")
    bs.add_parser("whoami", help="identity and credential source (never the token)")
    s = bs.add_parser("register", help="admin: register or update an agent")
    s.add_argument("name"); s.add_argument("--kind", required=True, choices=["bot", "orchestrator", "human", "service"])
    s.add_argument("--wake", required=True, choices=["webhook", "tmux", "poll"]); s.add_argument("--bot"); s.add_argument("--orchestrator")
    s.add_argument("--alias", action="append"); s.add_argument("--description"); s.add_argument("--notices", choices=["legacy", "bus"])
    s.add_argument("--digest-minutes", dest="digest_minutes", type=digest_minutes, default=60, help="minutes between digest wakes (default 60, minimum 5)")
    s.add_argument("--poll-window", dest="poll_window", type=int, metavar="MINUTES",
                   help="wake poll only: how often the agent checks in (10-10080); not unreachable in between. 0 clears it")
