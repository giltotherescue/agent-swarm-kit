#!/usr/bin/env python3
"""swarmctl: command line for the swarm backend. Bots, people and scripts all use this.

Settings come from the environment or ~/.config/swarm/client.env (KEY=VALUE lines):
  SWARM_URL         backend address, for example https://YOUR-WORKER.YOUR-TAILNET.ts.net
  SWARM_TOKEN_FILE  file holding your token (default ~/.config/swarm/client.token). Never paste tokens in chat.

Examples:
  swarmctl status
  swarmctl enqueue -p website --owner website-bot --pr brief.md
  swarmctl enqueue --owner website-bot --report-only --key seo-audit-2026-01 brief.md
  swarmctl enqueue -r you/app --command "npm ci && npm test" --owner app-bot - <<< "Run the full test suite"
  swarmctl enqueue --follow-up TASK_ID brief.md        continue earlier work (same repo, branch and folder)
  swarmctl review -r you/app --pr-number 12 -P codex --owner app-bot
  swarmctl list --state waiting
  swarmctl show TASK_ID ; swarmctl report TASK_ID
  swarmctl answer TASK_ID "Use the blue logo"
  swarmctl message TASK_ID "Also update the footer"
  swarmctl waiting list
  swarmctl waiting add --project website --bot website-bot --kind decision --ask "Ship the new homepage?" \\
      --rec "Ship it" --link https://example.com/preview --key homepage-v2
  swarmctl project set website --repo you/site --bot website-bot
  swarmctl bot set website-bot --notify-url https://example.com/hooks/website --notify-auth-file ~/.config/swarm/website.hook
  swarmctl bot test website-bot
  swarmctl log add marketing --kind feedback --by Sam "Too formal. Write like we talk to customers."
  swarmctl log add marketing --kind item --status needs-review "Spring sale ad, Facebook"
  swarmctl log brief marketing          read before drafting: standing rules plus 14 days of feedback
  swarmctl log list marketing --kind feedback,learning --days 30
  sudo swarmctl login codex | claude | github      worker: start a sign-in, print only the link and code (docs/worker-setup.md)
  swarmctl enqueue --chain --max-cycles 30 --owner app-bot -r you/app --pr polish.md   (see docs/long-running-jobs.md)
  swarmctl log export marketing --days 7 --out marketing-log.md
  sudo swarmctl drain | undrain | restart-when-idle    (on the worker)
  swarmctl orchestrator create app-steward --worker build-box -p app --owner app-bot --brief steward.md --start
  swarmctl orchestrator list | status NAME | logs NAME | start | stop | restart NAME   (see docs/orchestrators.md)
  swarmctl orchestrator message app-steward "Look at the signup page next"
  swarmctl orchestrator release app-steward 12 [--resend]   (after a delivery-unknown event: it arrived, or type it once more)
  swarmctl bus send chief "Deploy done" --no-reply ; swarmctl bus inbox ; swarmctl bus ack 7   (BUS_AGENT=NAME)
"""
