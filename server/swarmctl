    pj.add_argument("--no-push", action="store_true"); pj.add_argument("--allow-push", action="store_true")
    pj.add_argument("--allow-push-main", action="store_true", help="let tasks use --push-main (off by default)")
    pj.add_argument("--log-git", action="store_true", help="commit this project's weekly log export to a local git repo")
    pj.add_argument("--no-log-git", action="store_true")
    pj.add_argument("--no-push-main", action="store_true")
    pj.set_defaults(fn=cmd_project)

    lg = sub.add_parser("log", help="the project log: add, list, export (a history for every project, repo or not)")
    lg.add_argument("action", choices=["add", "list", "export", "items", "rules", "brief"]); lg.add_argument("project", nargs="?")
    lg.add_argument("summary", nargs="?", help="log add: one line saying what happened")
    lg.add_argument("--kind", help="activity, decision, result, item, feedback, learning or rule (list: comma list to filter)")
