[Unit]
Description=agent-swarm-kit backend (tasks, answers, reports, notifications)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=swarm
Group=swarm
EnvironmentFile=/etc/agent-swarm/swarm.env
ExecStart=/usr/bin/python3 /opt/agent-swarm-kit/server/swarm_backend.py
Restart=always
RestartSec=5
# Hardening: the backend can only write its own data folder.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/agent-swarm

[Install]
WantedBy=multi-user.target
