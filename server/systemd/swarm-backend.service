[Unit]
Description=agent-swarm-kit backend (tasks, answers, reports, notifications)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=swarm
Group=swarm
Environment=SWARM_BOT_KEYS_DIR=/etc/agent-swarm/bot-keys
Environment=SWARM_DB_BACKUP_DIR=/var/lib/agent-swarm/backups
EnvironmentFile=/etc/agent-swarm/swarm.env
ExecStart=/usr/bin/python3 /opt/agent-swarm-kit/current/server/swarm_backend.py
Restart=always
RestartSec=5
# Hardening: the backend can only write its own data folder and the bot key folder.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
UMask=0077
ReadWritePaths=/var/lib/agent-swarm /etc/agent-swarm/bot-keys

[Install]
WantedBy=multi-user.target
