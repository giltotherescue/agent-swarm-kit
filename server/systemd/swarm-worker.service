[Unit]
Description=agent-swarm-kit runner (claims tasks, runs Claude Code or Codex as the agent user, publishes)
After=network-online.target swarm-backend.service
Wants=network-online.target

[Service]
Type=simple
# The runner holds the worker token and the GitHub login. Agents run as the agent user through
# /usr/local/lib/agent-swarm/agent-exec (one sudoers rule) and never see either.
User=swarm-runner
Group=swarm-runner
Environment=HOME=/var/lib/swarm-runner
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=SWARM_AGENT_USER=agent
Environment=SWARM_WORKER_TOKEN_FILE=/var/lib/swarm-runner/worker.token
Environment=SWARM_RUNNER_DIR=/var/lib/swarm-runner
Environment=SWARM_HANDOFF_DIR=/srv/agent-swarm
Environment=SWARM_WORK_DIR=/home/agent/work
Environment=SWARM_REQUIRE_SCOPE=1
Environment=SWARM_RUN_AGENT=/opt/agent-swarm-kit/current/server/run-agent
EnvironmentFile=/etc/agent-swarm/swarm.env
ExecStartPre=+/usr/sbin/runuser -u agent -- /usr/bin/env -i HOME=/home/agent PATH=/usr/local/bin:/usr/bin:/bin /usr/local/bin/swarm-sync-secrets --if-configured
ExecStart=/usr/bin/python3 /opt/agent-swarm-kit/current/server/swarm_worker.py
Restart=always
RestartSec=10
UMask=0027

[Install]
WantedBy=multi-user.target
