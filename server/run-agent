#!/usr/bin/env bash
# run-agent: run one headless Claude Code or Codex session in a folder.
# Usage: run-agent <claude|codex> <model|default> <workdir> <prompt-file> [session-id-to-resume]
# Writes the session id to <workdir>/.task-context/session-<provider> so a later answer can resume the same
# session with the same provider. Each provider has its own file, so a fallback never mixes them up.
# Exit codes: the CLI's own code, 75 when the output shows a usage or rate limit, 124 on timeout
# (137 when the run ignored the stop signal and was killed 30 seconds later).
set -uo pipefail
PROVIDER="${1:?provider}"; MODEL="${2:?model}"; WORKDIR="${3:?workdir}"; PROMPT="${4:?prompt file}"; RESUME="${5:-}"
TIMEOUT="${SWARM_TASK_TIMEOUT:-14400}"
CTX="$WORKDIR/.task-context"; mkdir -p "$CTX"
rm -f "$CTX/session-$PROVIDER"
OUT="$CTX/agent-output.jsonl"; ERR="$CTX/agent-stderr.log"
cd "$WORKDIR" || exit 2

LIMIT_RE='(usage limit|rate limit|rate_limit|too many requests|429|quota exceeded|limit reached|hit your limit)'

case "$PROVIDER" in
  claude)
    args=(-p --permission-mode bypassPermissions --output-format stream-json --verbose)
    [[ "$MODEL" != default ]] && args+=(--model "$MODEL")
    [[ -n "$RESUME" ]] && args+=(--resume "$RESUME")
    timeout --kill-after=30 "$TIMEOUT" claude "${args[@]}" < "$PROMPT" > "$OUT" 2> "$ERR"
    code=$?
    sid=$(grep -o '"session_id":"[^"]*"' "$OUT" | head -1 | cut -d'"' -f4)
    ;;
  codex)
    args=(exec --json --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$WORKDIR")
    [[ "$MODEL" != default ]] && args+=(-m "$MODEL")
    if [[ -n "$RESUME" ]]; then args+=(resume "$RESUME" -); else args+=(-); fi
    timeout --kill-after=30 "$TIMEOUT" codex "${args[@]}" < "$PROMPT" > "$OUT" 2> "$ERR"
    code=$?
    sid=$(python3 -I - "$OUT" <<'PY'
import json
import sys

session = ""
terminal = None
with open(sys.argv[1], encoding="utf-8", errors="replace") as stream:
    for line in stream:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict):
            continue
        kind = event.get("type")
        if kind == "thread.started" and isinstance(event.get("thread_id"), str):
            session = event["thread_id"]
        elif kind == "turn.started":
            terminal = None
        elif kind in ("turn.completed", "turn.failed", "error"):
            terminal = kind
print(session)
sys.exit(0 if terminal == "turn.completed" else 1)
PY
    )
    verdict=$?
    if [[ $code -ne 124 && $code -ne 137 ]]; then
      if [[ $verdict -eq 0 ]]; then code=0; elif [[ $code -eq 0 ]]; then code=1; fi
    fi
    ;;
  *) echo "provider must be claude or codex" >&2; exit 2;;
esac

[[ -n "${sid:-}" ]] && printf '%s\n' "$sid" > "$CTX/session-$PROVIDER"
if [[ $code -ne 0 && $code -ne 124 && $code -ne 137 ]] && tail -c 20000 "$OUT" "$ERR" 2>/dev/null | grep -Eqi "$LIMIT_RE"; then
  exit 75
fi
exit "$code"
