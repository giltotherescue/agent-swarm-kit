# agent-swarm-kit settings. The setup script copies this to /etc/agent-swarm/swarm.env.
# Placeholders only. Real tokens never go in this file: they live in their own files (chmod 600 or 640).

# ---- Backend ----
# Where the backend listens. Keep it on localhost; Tailscale Serve or Funnel publishes it (see docs/backend.md).
SWARM_BIND=127.0.0.1:8750
SWARM_DB=/var/lib/agent-swarm/swarm.db
# The address bots use, for report links. Example: https://your-worker.your-tailnet.ts.net
SWARM_PUBLIC_URL=https://YOUR-WORKER.YOUR-TAILNET.ts.net
SWARM_ADMIN_TOKEN_FILE=/etc/agent-swarm/admin.token
# Default provider (claude or codex) and model for tasks that do not name one. "default" lets the CLI pick.
SWARM_DEFAULT_PROVIDER=claude
SWARM_DEFAULT_MODEL=default
# Attempts per task before it stops resuming on its own and asks the owner bot.
SWARM_MAX_ATTEMPTS=5

# ---- Worker ----
# How the worker reaches the backend. On a single box this is localhost.
SWARM_URL=http://127.0.0.1:8750
SWARM_BACKEND_WORKER_TOKEN_FILE=/etc/agent-swarm/worker.token
# The worker reads its own copy from /home/agent/.config/swarm/worker.token (chmod 600).
SWARM_WORK_DIR=/home/agent/work
# Tasks at once. Start with 2 on 4 vCPU / 8 GB. See docs/sizing-and-sandboxes.md.
SWARM_MAX_PARALLEL=2
# When Claude hits a usage limit, retry the task on this provider. Leave empty to wait for the limit to reset.
SWARM_FALLBACK_PROVIDER=codex
SWARM_FALLBACK_MODEL=default
# Per-task limits (applied with systemd-run). CPUQuota 200% means 2 CPUs.
SWARM_TASK_SCOPE=1
SWARM_TASK_CPU_QUOTA=200%
SWARM_TASK_MEMORY_MAX=75%
# Hours a single agent run may take before it is stopped.
SWARM_TASK_TIMEOUT=14400
# Do not claim new work when the box is this busy.
SWARM_MAX_LOAD_PER_CPU=1.5
SWARM_MIN_FREE_MEM_MB=1500

# ---- Cleanup, backups, alerts ----
SWARM_KEEP_DAYS=7
SWARM_SLIM_AFTER_DAYS=1
SWARM_SCRATCH_DAYS=14
SWARM_BACKUP_KEEP_DAYS=14
SWARM_DISK_ALERT_PERCENT=80
# Optional off-box copy of the nightly database backup, for example with rclone or restic.
# SWARM_OFFSITE_CMD=rclone copy {dir} YOUR-REMOTE:swarm-backups
