# agent-swarm-kit settings. The setup script copies this to /etc/agent-swarm/swarm.env.
# Placeholders only. Real tokens and keys never go in this file: they live in their own files.
# The systemd units already set the paths for the three users (agent, swarm-runner, swarm); you only
# need to change what is below.

# ---- Backend ----
# Where the backend listens. Keep it on localhost; Tailscale Serve publishes it to your tailnet (docs/backend.md).
SWARM_BIND=127.0.0.1:8750
SWARM_DB=/var/lib/agent-swarm/swarm.db
# The address bots use, for report links. Example: https://YOUR-WORKER.YOUR-TAILNET.ts.net
SWARM_PUBLIC_URL=https://YOUR-WORKER.YOUR-TAILNET.ts.net
SWARM_ADMIN_TOKEN_FILE=/etc/agent-swarm/admin.token
SWARM_BACKEND_WORKER_TOKEN_FILE=/etc/agent-swarm/worker.token
# Bot trigger keys, one file per bot, readable only by the backend. Never in the database or its backups.
SWARM_BOT_KEYS_DIR=/etc/agent-swarm/bot-keys
# Default provider (claude or codex) and model for tasks that do not name one. "default" lets the CLI pick.
SWARM_DEFAULT_PROVIDER=claude
SWARM_DEFAULT_MODEL=default
# Attempts per task before it stops resuming on its own and asks the owner bot.
SWARM_MAX_ATTEMPTS=5
# A task token stops working after this many hours, whatever happens.
SWARM_TASK_TOKEN_MAX_HOURS=8
# Protection when the backend is reachable from other machines.
SWARM_MAX_CONNECTIONS=32
SWARM_AUTH_FAIL_LIMIT=20
SWARM_MAX_OPEN_TASKS_PER_OWNER=100
# A task waiting on its owner bot gets one reminder after this many hours, and goes on Waiting on you after the next.
SWARM_REMIND_HOURS=12
SWARM_ESCALATE_HOURS=24
# Files (artifacts, attachments, work bundles) of tasks finished this many days ago are deleted. 0 keeps everything.
SWARM_FILE_RETENTION_DAYS=90

# ---- Runner (swarm-runner user) and tasks (agent user) ----
# How the runner reaches the backend. On a single box this is localhost.
SWARM_URL=http://127.0.0.1:8750
# The runner's copy of the worker token is /var/lib/swarm-runner/worker.token (mode 600, swarm-runner only).
SWARM_WORK_DIR=/home/agent/work
# Tasks at once. Start with 2 on 4 vCPU / 8 GB. See docs/sizing-and-sandboxes.md.
SWARM_MAX_PARALLEL=2
# When one provider hits a usage limit, retry the task on this provider. Leave empty to wait for the limit to reset.
SWARM_FALLBACK_PROVIDER=codex
SWARM_FALLBACK_MODEL=default
# Per-task limits (applied with a systemd scope as the agent user). CPUQuota 200% means 2 CPUs.
# All tasks together are also capped (setup installs /etc/systemd/system/user-UID.slice.d/50-swarm-limits.conf).
SWARM_TASK_SCOPE=1
SWARM_TASK_CPU_QUOTA=200%
SWARM_TASK_MEMORY_MAX=75%
# Seconds a single run (model or script) may take before it is stopped. The watchdog alerts 30 minutes after.
SWARM_TASK_TIMEOUT=14400
# The longest time limit one task may ask for (--timeout-minutes, or the long-running kind). See docs/long-running-jobs.md.
SWARM_TASK_TIMEOUT_MAX=86400
# The most cycles one chain may ask for (--chain --max-cycles).
SWARM_MAX_CYCLES=200
# Project log: most standing rules per project, and a folder for the weekly Markdown export (empty: no export).
SWARM_RULES_CAP=25
SWARM_LOG_EXPORT_DIR=/var/lib/agent-swarm/log-exports
# Do not claim new work when the box is this busy.
SWARM_MAX_LOAD_PER_CPU=1.5
SWARM_MIN_FREE_MEM_MB=1500

# ---- Orchestrators (optional, docs/orchestrators.md) ----
# Command that registers an orchestrator's fixed name on Agent Relay, run as the agent user. Empty: no Relay.
# SWARM_RELAY_REGISTER_CMD=relay agent register {name}
# Seconds a graceful stop waits for the agent's wrap-up; quiet seconds before a message is typed in.
# SWARM_ORCH_STOP_GRACE=120
# SWARM_ORCH_IDLE_SECONDS=20

# ---- Cleanup, backups, alerts ----
SWARM_KEEP_DAYS=7
SWARM_SLIM_AFTER_DAYS=1
SWARM_SCRATCH_DAYS=14
SWARM_BACKUP_KEEP_DAYS=14
SWARM_DISK_ALERT_PERCENT=80
# Optional off-box copy of the nightly database backup. Backups hold briefs, answers and reports, so use an
# encrypted remote, for example an rclone "crypt" remote or restic.
# SWARM_OFFSITE_CMD=rclone copy {dir} YOUR-ENCRYPTED-REMOTE:swarm-backups
